# Libration settings
# Butterworth low-pass cutoff in 1/yr (0.0005 = periods shorter than 2000 yr are damped) and its order
LIBRATION_FILTER_CUTOFF=0.0005
LIBRATION_FILTER_ORDER=2
# Highest frequency (1/yr) of the periodograms, and the power above which their peaks are reported
LIBRATION_FREQ_MAX=0.002
LIBRATION_SOFT=0.05

# Filtering config
FILTER=butter

# Cross-spectral coherence (sigma vs a/e/i, e vs i) — see docs/coherence.md
COHERENCE_ENABLED=True
# Skip rows with status non_resonant (kinematic and induced included); they dominate mass surveys
COHERENCE_SKIP_NON_RESONANT=True
# Per-bin false-alarm probability: gamma2_crit = 1 - alpha^(1/(n_seg-1))
COHERENCE_ALPHA=0.01
# Welch segmentation levels (comma-separated). The coarsest valid one decides.
COHERENCE_N_SEGMENTS=4,8,16
COHERENCE_WINDOW=hann
# Max coherent lines kept per pair per level in coherence.csv
COHERENCE_MAX_LINES=10
# Extra narrowing of the search band, in years. Empty = use the per-resonance-type
# preset (10000 for Lidov-Kozai and secular) and the intrinsic 4*dt .. T/(5*n_seg) limits.
COHERENCE_PERIOD_MIN=
COHERENCE_PERIOD_MAX=
# Measure whether e and i really exchange at the strongest coherent line -> zlk_coherent, zlk_check.
# Diagnostic: it changes no status. confirmed_ei is the period-specific zlk_ei_coupling (ZLK_EI_*); the status of
# the W28 tree reads, for an episodic row without a gate verdict, the deciding episode's own coupling.
ZLK_COHERENCE_CHECK=True
# Minimum |r| of band-passed e vs i for the antiphase line to count as a real exchange.
# A column only (zlk_coherent). PROVISIONAL: calibrated on two objects (591986 reaches 0.38 and
# is not resonant, 162474 reaches 0.79 and is). Revisit once a larger sample exists.
ZLK_MIN_ANTICORRELATION=0.5

# Integration settings
INTEGRATION_TMAX=628319
# The step in rebound units (2pi = 1 yr): 1.0 = 58 days. Fine for the main belt, but it does not resolve
# Mercury (88 d) or planet-crossing orbits: see docs/config.md before integrating NEAs or inner-planet terms.
INTEGRATION_DT=1.0
INTEGRATION_INTEGRATOR=SABA(10,6,4)
# Empty: the integrator's default, WHFast 0 and SABA 1 (reproduces earlier runs bit for bit). 0 merges the
# drifts of consecutive steps (faster); it changes the orbits at round-off level, and chaotic orbits diverge.
INTEGRATION_SAFE_MODE=
INTEGRATION_CORRECTOR=17
# The Moon as a separate body: Earth becomes the geocenter (Horizons 399) and the Moon (301) is added after
# Pluto. False = Earth is the Earth-Moon barycenter with the Earth+Moon mass. True needs INTEGRATION_INTEGRATOR=ias15
# (symplectic integrators are refused) and uses its own cache file, cache/solar-moon-<timestamp>.bin.
SOLAR_SYSTEM_MOON=False

# Secular resonances. proper: the planets enter through their mode longitudes g_j*t + phase_j and the
# body's node is measured from the invariable plane (what the classifier reads); osculating: the planets'
# osculating elements, right only for g1, g5, g6 terms. The planetary frequencies and phases are
# PLANETARY_FREQUENCIES / PLANETARY_PHASES in resonances/data/const.py (see docs/secular.md).
SECULAR_ANGLE_MODE=proper
# The proper angle is *reduced*: the forced terms at the planetary fundamentals that are not in the
# angle are subtracted from the body's e and i vectors (those in it are the resonance). False keeps
# only the invariable plane removed.
SECULAR_REMOVE_FORCED=True
# The planets' mode longitudes in a secular angle: 'linear' = g_j*t + phase_j of const.py, or 'measured' =
# fitted in the integration itself in sliding windows of SECULAR_PHASE_WINDOW years (needs SAVE_PLANETS=all;
# see resonances/secular/planet_modes.py). The inner modes wander by tens of degrees in 10-20 Myr.
SECULAR_PLANET_PHASES=linear
SECULAR_PHASE_WINDOW=5000000

# ===== Libration analysis v2 (resonances/resonance/analysis/settings.py; docs/config.md) =====
# Each line: meaning [unit] (convention = agreed threshold, not derived: a decision within
# CONFIDENCE_THIN_BAND of it is a thin margin U).

# --- Filter (shared) and the MMR cutoff rule: P_c = max(MMR_FILTER_SYNODIC_FACTOR x longest P_syn, P_floor / FILTER_MIN_LIBRATION_CUTOFFS),
#     P_floor the shortest libration (MMR_LIBRATION_PERIOD_MIN_YR; co-orbital: MMR_COORBITAL_PERIOD_FLOOR_FACTOR); the output step
#     does not enter: P_c <= 2 x step is invalid / undersampled, step >= min(P_orb, P_syn) / 2 flags short_period_aliased
# Butterworth order N of the sos low-pass; filtfilt gain G(P) = 1/(1 + (tan(pi dt/P)/tan(pi dt/P_c))^(2N)) (-> 1/(1 + (P_c/P)^(2N)) for P_c >> dt)
FILTER_ORDER=2
# turning points, passes and portrait use [t0 + x P_c, t1 - x P_c]: filtfilt edges spread ~ +-P_c
FILTER_EDGE_TRIM_CUTOFFS=1.0
# the floor term of the cutoff is the shortest libration / this (MMR: P_floor, secular/ZLK: P_min): where it sets P_c, that libration keeps G = 1/(1 + this^-4) = 0.94; secular/ZLK: a measured libration period below this many P_c sets filter_too_slow (MMR: G(P_cyc) below MMR_L8_GAIN_FULL); shape checks become not_measured
FILTER_MIN_LIBRATION_CUTOFFS=2.0
# a time grid is uniform for the filter when every step is within this fraction of the median step (REBOUND rounding)
FILTER_GRID_RTOL=0.001
# P_c >= this x the longest synodic period with the planets of the angle (leak <= 0.5 deg)
MMR_FILTER_SYNODIC_FACTOR=1.5
# P_c >= this x the body's own orbital period 2 pi / n(<a>) (0 = off): heliocentric elements are osculating about GM_sun alone, while a body moves about the Sun and the planets inside its orbit, so its a and lambda carry a wave at its own P_orb (half-amplitude in a ~ 2 e a sum m_inside / M_sun); it binds only beyond a planet's 1:2, where P_orb > P_syn (TNOs: 15874 5N-23, 523683 2U-9 at 379 yr); barycentric elements are a separate study (convention)
MMR_FILTER_ORBIT_FACTOR=1.5
# shortest libration period of a non-co-orbital MMR, a convention (not a physical minimum: Hildas ~260 yr; the forced waves of 52356 and 23240 are 115-121 yr): faster 'episodes' are forced waves and the TP prominence covers what sigma_f holds faster than this (0 = off); co-orbitals use MMR_COORBITAL_PERIOD_FLOOR_FACTOR [yr] (convention)
MMR_LIBRATION_PERIOD_MIN_YR=150.0
# rule G1f (card g08-2 B): a two-body angle that is not 1:1 and has no libration over the record at its floor is analyzed again at the floor max(T0_th / sqrt(MMR_STRENGTH_CHECK_RATIO), 2 dt FILTER_MIN_LIBRATION_CUTOFFS), T0_th the shortest small-amplitude period of its directly averaged potential at snapshots consistent with sigma's swings; kept only when its decisive cycle is faster than the floor, F passes by direct averaging, the theoretical center lies inside every observed swing and L4 passes (2001 VC2 16E-17: 105 yr against T0_th 112 yr); the floor, short_period_aliased and three-body angles are unchanged (no new threshold: it reuses MMR_STRENGTH_CHECK_RATIO)
MMR_SUBFLOOR_PASS=True
# a co-orbital angle (1:1 with its planet) librates no faster than this x the linear tadpole period P_orb / sqrt(27 mu / 4) of the planet (Jupiter 148 yr, Earth 222 yr, Mars 1274 yr); wide horseshoes are faster (Earth horseshoes of the benchmark down to 0.65 of it); its P_c is the floor / FILTER_MIN_LIBRATION_CUTOFFS (0 = off) (convention)
MMR_COORBITAL_PERIOD_FLOOR_FACTOR=0.5
# rule coorbital_floor_profile (W28 C3, cards g02-1 A, q-3 A): a 1:1 run whose turning points (read on the orbit-averaged angle) all reflect on a top of the averaged potential (the planet or L3) has the floor MMR_COORBITAL_PERIOD_FLOOR_FACTOR x the period of the loop through those turns, when its local 1:1 law has K / K_theory > 0 (2003 YN107: 103 yr against a 119-yr loop); other runs keep the tadpole floor, the QS well its own; the TP prominence then counts as fast only what is faster than the factor x the fastest horseshoe loop turning MMR_COORBITAL_MIN_TURN_HILL Hill radii from the planet (False = the tadpole floor for every run)
MMR_COORBITAL_PROFILE_FLOOR=True
# the closest a physical horseshoe turn comes to its planet, in Hill radii a_P (mu / 3)^(1/3): the fastest horseshoe loop turning there (x MMR_COORBITAL_PERIOD_FLOOR_FACTOR, at most the tadpole floor) is the period below which a 1:1 angle holds no libration, the reference of the fast residual of the TP prominence; closer in the averaged problem does not hold (an encounter; Castro-Cisneros et al., as MMR_STRENGTH_MIN_DISTANCE_HILL) (convention)
MMR_COORBITAL_MIN_TURN_HILL=3.0
# a 1:1 turn is read on |a - a_P| over [near, far] x the run's median half-cycle on each side of it (columns cpl_turn_out_in_*, cpl_turn_da_ratio_*; the W28 C1 study's window, not varied there); no status reads them yet (convention)
MMR_COORBITAL_TURN_SIDE_WINDOW=0.1,0.4
# rule coorbital_edge_turn (W28 C4, cards g02-2 A, g01-3 A): a prograde 1:1 angle whose first or last run misses the turning point the filter's edge trim hides takes it from the raw angle averaged over MMR_COORBITAL_EDGE_TURN_ORBITS orbits, only when it closes a cycle of a run that was no episode and the reversal holds: prominence >= MMR_COORBITAL_EDGE_TURN_MIN_DEG, a reflection on a top of the averaged potential (the planet or L3), a crossing a_P and |ln out/in| <= MMR_COORBITAL_TURN_ENERGY_TOL (2006 BZ147: 960 yr, 40 yr before the end; False = no such turning point)
MMR_COORBITAL_EDGE_TURN=True
# rule coorbital_edge_turn: the raw angle and a are averaged over this many of the body's orbital periods (a centered running mean, shorter at the record ends) before the edge reversal is read; the W28 C1 study's average of a 1:1 leg (it drops the ripple of one orbit and its harmonics) (convention)
MMR_COORBITAL_EDGE_TURN_ORBITS=3.0
# rule coorbital_edge_turn: a reversal of the averaged raw angle in the edge trim counts when it swings at least this far on both sides, from the run's last (first) turning point and back towards the record edge (the W28 C1 study's reversal of a 1:1 leg; 2007 VU6 at 994 yr swings back 18.8 deg in the 6 yr left) [deg] (convention)
MMR_COORBITAL_EDGE_TURN_MIN_DEG=20.0
# a 1:1 turn is a reflection by the averaged potential, which mirrors |a - a_P| (time reversal), when |ln(out/in)| <= this, out/in = |a - a_P| after / before it (coorbital_geometry.turn_conservation); else a kick. 0.34 = ln 1.4, the band [1/1.4, 1.4] of the W28 C1 study, the 90th percentile (0.331) of the turns of confirmed 1:1 cycles (rule coorbital_edge_turn; the single-leg rule of C6 shares it)
MMR_COORBITAL_TURN_ENERGY_TOL=0.34
# rule coorbital_leg, leaf G4c (W28 C6, cards g02-4..g02-7, q-4 A): a prograde 1:1 angle without a librating episode is judged on the legs of its averaged angle outside the accepted runs (between two reversals, less than a turn, period 2 L >= the floor less CONFIDENCE_THIN_BAND): a clean leg (tadpole, horseshoe or quasi-satellite) whose local 1:1 law and energy integral pass and whose two turns reflect (|ln out/in| <= MMR_COORBITAL_TURN_ENERGY_TOL, zone <= MMR_COORBITAL_TURN_ZONE_MAX) -> transient (cap one_coorbital_leg); any one of these failing -> uncertain/one_coorbital_leg; a clean leg cut by the record edge whose observed turn reflects -> uncertain/insufficient_time (extend); both turns scatter -> non_resonant with the near-episode cap; the strongest outcome of the legs decides (False = the circulation leaf as before)
MMR_COORBITAL_SINGLE_LEG=True
# rule coorbital_leg: the local 1:1 law of a single leg is fitted on the leg widened by this x its length L on each side (the W28 C1 study: the leg alone is too short for the energy integral, +-0.25 L keeps 85 % of the legs of confirmed cycles passing and separates them 2.0x from the single legs of non_resonant rows) (convention)
MMR_COORBITAL_LEG_WINDOW_FACTOR=0.25
# rule coorbital_leg: the leg's own cutoff is max(this x P_orb, MMR_COORBITAL_LEG_CUTOFF_FRACTION x 2 L): it drops the orbital ripple (the angle's own P_c is as long as the shortest legs; W28 C1 study) (convention)
MMR_COORBITAL_LEG_CUTOFF_ORBITS=2.0
# rule coorbital_leg: the leg's own cutoff is at least this x its period 2 L (W28 C1 study) (convention)
MMR_COORBITAL_LEG_CUTOFF_FRACTION=0.1
# rule coorbital_leg: a 1:1 turn reflects only at a level the averaged potential can reverse, |a - a_P| / da_max <= this on the leg's side (da_max: the largest |da| the highest R~ before the planet or L3 ahead still reverses, `coorbital_geometry.da_max`); 1.1 covers 97.6 % of the turns of confirmed 1:1 cycles (q95 1.04) in the W28 C1 study, against 77 % of the turns of single legs
MMR_COORBITAL_TURN_ZONE_MAX=1.1
# rule coorbital_leg: also read a single leg whose local 1:1 law fails or has K <= 0 as a scattering (non_resonant with the near-episode cap, the W28 C1 recommendation; a clean edge leg then needs its law too). False = q-4 A literally: a failed law is one discrepancy, uncertain (7 co-orbital records differ, C1)
MMR_COORBITAL_LEG_FORCE_GATE=False
# rule single_half_libration, leaf G4h (W28 C6, q-5 i): an angle that is not 1:1, circulating without an accepted run, whose bounded half-swing (two turning points, half-amplitude < pi, period >= the floor less CONFIDENCE_THIN_BAND) lies between passages over the top (or a passage and the record edge) and follows the resonance's own one-harmonic law a_dot = A sin sigma + B cos sigma + C (R^2 >= MMR_FORCE_R2_FAIL on each half of its window, the force turning sigma back at both turning points) -> uncertain/one_half_libration (review), at the record edge uncertain/insufficient_time (extend); without the law the circulation stays (the W28 C15 audit: 18 such swings, 1 with the law, 42946 43S-6) (False = the circulation leaf as before)
MMR_SINGLE_HALF_LIBRATION=True
# rule single_half_libration: the one-harmonic law of a half-swing is fitted on it widened by this x its length on each side (the window of the 1:1 leg's law, MMR_COORBITAL_LEG_WINDOW_FACTOR; the W28 C15 audit) (convention)
MMR_HALF_LIBRATION_WINDOW_FACTOR=0.25
# rule end_arc_extend (W28 C14, card g01-7 A): read how sigma_f meets the record edges after circulation. At the end, a pass of >= one revolution whose stretch after its last completed revolution lasts longer than MMR_END_ARC_SLOWDOWN_FACTOR x the longest revolution of the pass and, doubled, MMR_END_ARC_MIN_FLOOR_PERIODS x the floor, with no turn of the slow center and no librating episode in it: final_regime arc (range >= pi) or stall, flag extend_time (forward), and a non_resonant circulation is capped at medium (record_ends_unresolved). At the start the mirror, and one reflection of the slow center an edge cuts (< one revolution between the turn and the edge, >= one beyond it), give the flag only (backward at the start, forward at the end); so do the clean 1:1 edge legs of leaf G4c and the edge half-librations of G4h (False = none of this)
MMR_RECORD_EDGE_STRETCH=True
# rule end_arc_extend: an edge stretch (slowdown or reflection) of length D counts when 2 D is at least this many periods of the angle's floor (the shortest libration it may have): the stretch holds no turn, so a cycle through it lasts at least 2 D (a 1:1 leg's 2 L is read so); a shorter one could be no cycle of this resonance [P_floor] (convention)
MMR_END_ARC_MIN_FLOOR_PERIODS=1.0
# rule end_arc_extend: the stretch after the last completed revolution of the edge pass is a slowdown when it lasts more than this x the longest revolution of the pass (its mean rate below 1/this of the circulation's). A circulation whose rate depends on sigma alone completes the next revolution sooner than a full one takes (the bound 1), but a slowly drifting rate exceeds it a little: 2017 XF62 20 kyr 1.005, 2024 TY11 20 kyr 1.10, against 2022 BB2 11.5 (convention)
MMR_END_ARC_SLOWDOWN_FACTOR=2.0
# rule coorbital_well_cut (W28 C7, cards g03-1 A, g03-9 A): a prograde 1:1 episode ends only where sigma crosses a separatrix (a revolution of sigma_f or of the orbit-averaged raw angle). A run whose cycle bands do not overlap is accepted when every full cycle holds a minimum of the averaged potential (to within the run's turning-point prominence) and its centers stay within one turn; neighboring accepted runs join across a half-cycle that does not circulate; no regime cut (center step, stall) applies. Changes of well and of amplitude are annotations (episodes.csv marks). False = the band test, the regime cuts and the union of regimes as before
MMR_COORBITAL_WELL_EPISODES=True
# rule coorbital_well_core (the author 2026-11-14 on 2024 JR16, Codex's variant; needs MMR_COORBITAL_WELL_EPISODES): a 1:1 run the band test rejects and some of whose cycles hold no well of the averaged potential is kept from its cores, the maximal blocks of cycles that hold one (each accepted on its own by the band test or in its wells); the first core continues back and the last forward over the run's other turning points while sigma crosses neither the planet nor L3 (unless the core does), nor swings over the top, nor circulates: the continued run is one episode, its core gives the cycle count (episodes.csv core_t0_yr/core_t1_yr, mark unheld@t0:t1). Failing cycles between two cores split the run, they are never bridged; what lies beyond a crossing is a rejected edge piece. No threshold of its own. False = such a run is rejected whole as before
MMR_COORBITAL_WELL_CORE=True
# rule coorbital_residence (W28 C8, cards g03-3 C, g03-8 A, g03-9 A): with the wells of MMR_COORBITAL_WELL_EPISODES, every accepted 1:1 run gets an inferred residence, the stay around its core (its measured turning points) over the legs of the raw angle averaged over MMR_COORBITAL_EDGE_TURN_ORBITS orbits (reversals of MMR_COORBITAL_EDGE_TURN_MIN_DEG) until a leg sweeps LIBRATION_EDGE_ARC_REV turns or the record ends, and each of its sub-regimes its own 1:1 law (episodes.csv residence_*, subregime_checks). Data only: coverage, edges, margins and the status read the core. False = none of it
MMR_COORBITAL_RESIDENCE=True
# rule G1q: a prograde 1:1 angle whose orbit-averaged angle turns inside the quasi-satellite well of the averaged potential during a stay of >= MMR_COORBITAL_QS_TRIGGER_PERIODS loops through its turns, and that has no libration over the record, is analyzed again with the floor MMR_COORBITAL_PERIOD_FLOOR_FACTOR x P_QS (episodes centered outside the well keep the tadpole floor); kept when that pass finds a libration in the well (2010 CG236: 8 yr) (convention)
MMR_COORBITAL_QS_FLOOR=True
# rule G1q (W28 C5, card g01-2): the second pass runs when the orbit-averaged angle turns in the quasi-satellite well (a reversal of at least MMR_TP_PROMINENCE_FLOOR_DEG) during a stay of >= this x the period of the loop of the averaged potential through the stay's own turns (the longest small-amplitude P_QS along it when no loop joins them): one loop is the shortest stay that turns on both sides of the well. Only the trigger: the pass is kept by its own return, force law and energy integral. The low-e well is not harmonic: 2002 PN stays 26 yr, its loop (K/K_theory 1.00) takes 17.8 yr, the loop through its turns 19.5 yr, the small-amplitude P_QS 32.5 yr (convention)
MMR_COORBITAL_QS_TRIGGER_PERIODS=1.0
# rule G1q: an episode counts as centered in the quasi-satellite well (and takes its floor) only where the averaged potential has that well on at least this share of the episode's samples; otherwise it keeps the tadpole floor (convention)
MMR_COORBITAL_QS_WELL_SHARE=0.5
# rule G1q (cost): the 1:1 force law of the quasi-satellite pass reads the elements in blocks of P_QS,min (not longer than the angle's own P_c), but in no more than this many over the record (longer blocks then): each block may need its own table of the averaged potential (2010 CG236 over 20 kyr: 3774 blocks of 5.3 yr, 45 s; 1000 blocks of 20 yr fail its energy integral, R^2 0.11)
MMR_COORBITAL_QS_MAX_BLOCKS=4000
# rule coorbital_qs_run_floor (G1q pass only; needs MMR_COORBITAL_PROFILE_FLOOR and MMR_COORBITAL_QS_FLOOR): a run inside the quasi-satellite well whose turning points (on the orbit-averaged angle) all lie in that well has the floor min(the QS floor, MMR_COORBITAL_QS_LOOP_FACTOR x the loop of the averaged potential through its own turns, not below the period the pass filter keeps at gain MMR_L8_GAIN_FAIL), when its local 1:1 law has K / K_theory > 0, and the libration image of the TP prominence reads the same floor: the low-e QS well softens towards its barrier, so the small-amplitude P_QS is no lower bound (54509 YORP: 112 yr at 1 deg, 49.9 yr at 26 deg; a 50-yr QS run of 11 TPs was below the 55.7-yr QS floor). False = the QS floor for every run in the well
MMR_COORBITAL_QS_RUN_FLOOR=True
# rule coorbital_qs_run_floor: the floor of a quasi-satellite run is this x the loop through its own turns, a prediction at its own amplitude (no margin for extrapolating from P(0), as MMR_COORBITAL_PERIOD_FLOOR_FACTOR has): counted QS runs read P / loop 0.84-1.05, synthetic oscillations faster than the Earth's force allows 0.54-0.65 (a sine at 0.76 is not separated); also the factor of rule coorbital_pair_loop_floor (MMR_COORBITAL_PAIR_LOOP_FLOOR) (convention)
MMR_COORBITAL_QS_LOOP_FACTOR=0.7
# rule coorbital_pair_loop_floor (the author 2026-11-14, 2003 YN107: the designers' amin07h with Codex's witness; needs MMR_COORBITAL_PROFILE_FLOOR): a 1:1 run with a turn that is no reflection on a top (or a pair of turns no loop joins), which keeps the tadpole floor otherwise, has the floor MMR_COORBITAL_QS_LOOP_FACTOR x the median loop of its reflecting pairs whose turns are both >= MMR_COORBITAL_PAIR_LOOP_MIN_HILL Hill radii from the planet (inside the Hill sphere the planet holds the body), at most the tadpole floor, when its own local 1:1 law has K / K_theory > 0 and passes the force check in full (R^2 >= MMR_FORCE_R2_FULL in both halves, K / K_theory within MMR_COORBITAL_SCALE_RATIO_MAX): its floor is uncertain, so the planet's force must be seen moving it. No threshold of its own. False = the tadpole floor for such a run
MMR_COORBITAL_PAIR_LOOP_FLOOR=True
# rule coorbital_pair_loop_floor: the closest a turn of a reflecting pair may lie to the planet, in Hill radii a_P (mu / 3)^(1/3) in longitude: the Hill sphere, inside which the planet, not the Sun, holds the body. The pair-loop floor asks for the run's own 1:1 law in full, so the measured force, not the averaging margin of MMR_COORBITAL_MIN_TURN_HILL, keeps out an encounter (the author 2026-11-15, 2022 RD2 c075: a horseshoe of five turns at 0.2-2.2 Hill radii, |delta a| kept at each, loops through its turns 81 yr against 76 yr observed)
MMR_COORBITAL_PAIR_LOOP_MIN_HILL=1.0
# the 1:1 coverage audit after the policy (prograde 1:1 only; flags and columns, never a status): flag floor_above_own_loop when a floor exceeds the loop of the averaged potential through the turns of the run it rejects, flag uncovered_bounded_run when the orbit-averaged angle holds a bounded run of >= MMR_COORBITAL_AUDIT_MIN_HALF_CYCLES half-cycles inside the window that no counted episode or span covers; both enter review_reasons (columns aud_*). False = neither
MMR_COORBITAL_COVERAGE_AUDIT=True
# coverage audit: a turning point of the orbit-averaged angle needs a reversal of at least max(this, MMR_COORBITAL_AUDIT_NOISE_FACTOR x its noise) (at 20 deg the 17-deg QS swing of 2015 SO2 is missed; 5 deg changes the Earth survey by 1 %) [deg] (convention)
MMR_COORBITAL_AUDIT_MIN_SWING_DEG=10.0
# coverage audit: the reversal of a turning point is at least this x the noise 1.4826 MAD of the averaged angle less its own average over the same window (the jitter the average leaves; the survey sweep's value) (convention)
MMR_COORBITAL_AUDIT_NOISE_FACTOR=5.0
# coverage audit: in a bounded run every turn returns near the one two half-cycles before, |x_(i+2) - x_i| <= 2 x this x the smaller neighbouring half-amplitude (Earth survey: 0.3 -> 450, 0.8 -> 479 stretches, 453 at 0.5) (convention)
MMR_COORBITAL_AUDIT_CENTRE_TOL=0.5
# coverage audit: a bounded run (and a missed stretch of it) has at least this many consecutive half-cycles: 4 is the smallest count at which the centre test is defined (two maxima and two minima); fewer inside the window is an edge stretch (columns only) (convention)
MMR_COORBITAL_AUDIT_MIN_HALF_CYCLES=4
# x2 guard: the TP counts at P_c and 2 P_c on their common interval may differ by this many (one TP at each end) or by MMR_FILTER_GUARD_TP_REL of the larger count; more is a change (filter_sensitive) (convention)
MMR_FILTER_GUARD_TP_ABS=2
# x2 guard: relative tolerance of the TP counts (see MMR_FILTER_GUARD_TP_ABS) (convention)
MMR_FILTER_GUARD_TP_REL=0.1
# x2 guard: the decisive episode (else any accepted episode) whose start or end moves by more than this many libration periods is a change (convention)
MMR_FILTER_GUARD_BOUNDARY_PERIODS=1.0
# x2 guard: the median cycle energy h (separatrix 1) changing by more than this x max(1, the smaller |h|), or across 1, is a change (relative far above the separatrix: h ~ 1e4-1e7 of a far circulation moves by < 1 %) (convention)
MMR_FILTER_GUARD_H_TOL=0.1
# x2 guard: the largest half-amplitude of the decisive episode against its counterpart at 2 P_c (else of the episode with the most TPs) changing by more than this fraction is a change; energy and shape are compared only when the gain at P_cyc of the 2 P_c filter is >= MMR_L8_GAIN_FULL (else not checked) (convention)
MMR_FILTER_GUARD_AMP_REL=0.2
# explicit cutoff period overriding the rule (empty = rule) [yr]
MMR_FILTER_CUTOFF_YR=
# subtract sum_j k_j dlambda_j (great inequality) from the angle when planets are saved
MMR_RIPPLE_REMOVE=True
# period band of the diagnostic correlation of the subtracted ripple with the angle (flt_ripple_corr) [yr]
MMR_RIPPLE_BAND_YR=300.0,3000.0
# the ripple is subtracted when the saved angle equals the combination of the saved longitudes within this [deg]
MMR_RIPPLE_RECONSTRUCTION_MAX_DEG=1.0

# --- MMR sampling: alias branches and the predictive unwrap
# 'predictive' = unwrap by the rate model from a; 'numpy' = np.unwrap (diagnostic)
MMR_UNWRAP=predictive
# 99th percentile of the per-step model error of the lambda part for a stitchable record [deg]
MMR_UNWRAP_MAX_RESID_P99_DEG=45.0
# largest single per-step model error of the lambda part (pi/4 below pi) [deg]
MMR_UNWRAP_MAX_RESID_DEG=135.0
# a step with |residual| above this is unwrap_step_suspect [deg]
MMR_UNWRAP_SUSPECT_RESID_DEG=90.0
# window of the varpi slope used as the slow term of the rate model [yr]
MMR_VARPI_REF_WINDOW_YR=5000.0
# |p| de_sp/e above this (pi/4) = jitter_low_e (the osculating wobble of p varpi: a flag and a cap <= medium); undefined_phase also needs varpi itself undefined (MMR_VARPI_UNDEFINED_MAX_SHARE); locally |p| s/|z_f| = phase_undefined_local [rad]
MMR_JITTER_MAX_RAD=0.785
# undefined_phase needs varpi's own (p = 1) local scatter s/|z_f| above MMR_JITTER_MAX_RAD on more than this share of the measured record (not measured: undefined_phase as before, jitter_low_e and the full angle failing) (convention)
MMR_VARPI_UNDEFINED_MAX_SHARE=0.5
# periods shorter than this make the short-period e scatter de_sp; the band of the slow vector z_f = <e exp(i varpi)> [yr]
MMR_JITTER_BAND_YR=50.0
# step verdict resolved: |nu| dt <= this [deg]
MMR_STEP_RESOLVED_DEG=90.0
# far_from_resonance: |<a> - a*| >= this x the a scale of the record, max(half the a range, |a(lambda_dot) - <a>|): a libration about a* needs the slow a to reach a* (no strength enters: mu e^q is not a bound)
MMR_FAR_FROM_RES_FACTOR=10.0
# the a range of the rate model (nu_lo, nu_hi, alias branches, far ratio) is the [x, 100 - x] percentiles of a [%]
MMR_AXIS_RANGE_PERCENTILE=1.0
# a saved planet's n_j is the slope of its unwrapped lambda_j only when no step errs from the table rate by more than this; otherwise the table value [deg]
MMR_PLANET_UNWRAP_MAX_STEP_DEG=90.0
# alias_np_unwrap_differs: predictive and np.unwrap revolutions differ by more [rev]
MMR_ALIAS_NUMPY_REV_TOL=0.5
# harmonics m of synodic waves checked for folding into [P_cyc/2, 2P_cyc]
MMR_ALIASED_LINE_HARMONICS=3
# a folded synodic line is reported when its period is within [P_cyc/x, x P_cyc]
MMR_ALIASED_LINE_BAND_FACTOR=2.0
# round values a resample step (and smp_fold_free_step_yr) is chosen from [yr]
MMR_RESAMPLE_STEPS_YR=0.05,0.1,0.2,0.25,0.5,1.0,2.0,2.5,5.0,10.0
# recommended step <= P_cyc / this (an undersampled record and the dry-run: the shortest libration P_floor / this)
MMR_RESAMPLE_STEPS_PER_CYCLE=20.0
# an extension asks for at least this x the record length T (the total length from the start epoch); also secular/ZLK
MMR_EXTEND_MIN_SPAN_FACTOR=2.0
# insufficient_time/extend: the next check is round_up(max(f_min T, min(N, this x T))), N the estimate from the period (base_extend_to_years); a budget, not a sufficiency estimate: the record is analyzed again after it (N8); also every secular/ZLK extension (`analysis.secular.extend`); minimal policy clause C: a needed veto not measured for lack of length extends when its record is <= this x T, else review (convention)
MMR_NEXT_CHECK_SPAN_FACTOR=4.0
# insufficient_time from G5w (an unfinished slow swing in the resonance's own well): the record needs this many slow periods, N = this x P_slow + the edge trims (base_extend_to_years), instead of one cycle; a budget: 523683 2U-9, P_slow 112 kyr in 100 kyr, asks for 400 kyr, not 200 kyr (less than two cycles) (convention)
MMR_EXTEND_SLOW_CYCLES=3.0
# an uncertain row whose force law (L4) has fewer than MMR_FORCE_MIN_WINDOWS windows while its last episode reaches the record end (B9, A-FW) asks for t_start(last episode) + this x MMR_FORCE_WINDOW_CYCLES x P(last episode), rounded up; a budget (the action and extend_to_years only): 2003 TX9 3E+2J-10 asks for 30 kyr (convention)
MMR_EXTEND_FORCE_WINDOWS=2.0

# --- Geometry of an angle (shared): turning points, center, episodes, slips, stalls, jumps
# turning points of one full cycle: an episode needs this many; a secular moving center too. Changing it also changes the minimal policy's extend bound 2T / LIBRATION_MIN_TURNING_POINTS (fewer than three half-periods fit the record)
LIBRATION_MIN_TURNING_POINTS=3
# a run that would be a librating episode but for its count (half-cycles below pi, no over-the-top neighbor, period not below the shortest libration) and lacks at most this many turning points is a near-episode: a verdict without libration gets flag near_episode, confidence <= medium; 0 = off
LIBRATION_NEAR_EPISODE_TP_DEFICIT=1
# an episode covers a record edge when it starts (ends) within this many periods of it, or when no turning point is missing at the edge of the analysis window (that gap not longer than the longest TP-to-TP step of the episode, nor than this many periods) and the stretch the filter trims off that edge is within this many periods
LIBRATION_COVERAGE_PERIODS=1.0
# MMR: two consecutive librating episodes join into one libration over the record (G2, `covering_union`) only when the gap between them is bounded: every sample of sigma_f there lies within this margin of the band of one of the two (its center at the facing full cycle +- its half_amp_max) or of the band carried linearly between those centers (+- the larger half_amp_max), however long the gap (W28 g06-5: 2001 WK15 32E-39, 2002 XA 5J-2) [deg] (convention)
LIBRATION_UNION_BAND_MARGIN_DEG=10.0
# a gap between turning points above this x the median half-period splits a run
LIBRATION_EPISODE_GAP_FACTOR=3.0
# a run whose center moves is judged again on its longest stretch of full periods <= this x their median (a slow edge cycle is a change of regime, not part of the stationary libration), and may drop one edge half-cycle slower than this x the median half-period
LIBRATION_REGULAR_PERIOD_RATIO=2.0
# an exit (entry) is observed, not suspected, when the angle runs at least this many turns away from the last turning point of the last episode to the record end (from the record start to the first one) and moves monotonically there: the orbit-averaged raw angle of an MMR, sigma_f of a secular or ZLK angle (no orbit to average; W36); that edge is then not covered (an arc > 2 pi is not a piece of libration) [rev] (convention)
LIBRATION_EDGE_ARC_REV=1.0
# MMR: two opposite turning points are one closed cycle when sigma_f crosses their mid-level before the first and after the second in the same direction, a returning to within this x its swing there, the rate to within this fraction, and sigma_f crossing the mid-level between them as fast as at the first crossing, the other way (closure by phase return; 2016 CA138: 0.08 %, 0.2 %, 0.1 %) (convention)
LIBRATION_RETURN_TOL=0.05
# MMR: the phase return also needs (t_b - t_a) / (2 x the time between the two turning points) within 1 +- this (the quarter-period symmetry of a cycle; a circulation creeping back between two turns gives ~0.5; 2016 CA138: 1.00) (convention)
LIBRATION_RETURN_PERIOD_TOL=0.25
# MMR: the phase return also needs corr(sigma_dot, sign(c) (a - mean a)) >= this between the two crossings (a kinematic back-swing with a flat a is no cycle); the value of MMR_IDENTITY_CORR_MIN
LIBRATION_RETURN_IDENTITY_CORR_MIN=0.9
# MMR: the phase return of two opposite turning points is tried at the mid-level and at the levels k / (n + 1) of their swing, k = 1..n, with the same conditions, a level counting only inside a band of closing levels (LIBRATION_RETURN_MID_BAND_LEVELS for the mid-level, LIBRATION_RETURN_BAND_LEVELS for another); the mid-level is kept when it counts, else the best match (the mid-level is a convention, any level is a section the cycle crosses twice; 164207 never crosses its mid-level before the horseshoe turn); 0 or 1 = the mid-level only, alone (convention)
LIBRATION_RETURN_LEVELS=19
# MMR: a level other than the mid-level closes a cycle by its phase return only inside at least this many consecutive closing levels of LIBRATION_RETURN_LEVELS (the mismatches change continuously with the level, a real return holds over a band of sections; 2025 RB7 at 1 kyr closes at 0.20-0.25, 164207 at 0.15-0.20) (convention)
LIBRATION_RETURN_BAND_LEVELS=2
# MMR: the mid-level closes a cycle by its phase return inside at least this many consecutive closing levels of LIBRATION_RETURN_LEVELS (2: one closing neighbor), counted over the observable levels only: a level whose crossing may lie beyond the record neither closes nor breaks the band, so a mid-level without an observable neighbor closes alone (a 400-yr cosine on -104..304 yr); 1 = the mid-level alone (convention)
LIBRATION_RETURN_MID_BAND_LEVELS=2
# MMR: a verdict that rests on a cycle closed only by its phase return (two turning points) has confidence <= medium (cap one_return_cycle) (convention)
LIBRATION_RETURN_CYCLE_CAPS_MEDIUM=True
# MMR: a run whose center moves is cut at a center step between two measured regimes or at a stall of its slow center (524522 1V-1, 385266 16N-27); off: such a run stays one rejected run (convention)
LIBRATION_REGIME_CUTS=True
# MMR: a run whose center moves is cut at a stall of its slow center: at least this many independent full cycles whose midpoints move less per period than the cycles swing (385266 16N-27, 55-95 kyr); a steady drift has none (convention)
LIBRATION_STALL_MIN_CYCLES=3
# MMR (rule q, W28): two runs broken by one half-cycle over the top in sigma are one run when that half-cycle stays below the top in psi = sigma - c(t) of the moving well and the joined run passes the band test (82831 13M-24); off: every over-the-top half-cycle in sigma breaks the run (convention: an on/off of a geometry rule; over the top means over the potential's maximum, which moves with the well)
LIBRATION_FRAME_JOIN=True
# MMR (rule s, W28): after a stall cut, a leftover piece next to the stall joins it when its cycles have the stall's period and the joined piece passes the band test (385266 16N-27, 56.6-98.7 kyr); off: the leftover stays a piece of its own (convention: an on/off of a geometry rule; a cut must separate two regimes)
LIBRATION_STALL_JOIN=True
# MMR (rule regime_cut_mark, W28 C16, q-5 i): two neighboring accepted pieces of a center-step or stall cut are one episode when the last full cycle before the cut and the first after it share a band (m +- A overlap > 0) and a period (ratio <= LIBRATION_REGULAR_PERIOD_RATIO): sigma stays in one libration region, and the cut becomes a mark (episodes.csv marks centre_step@t0:t1, stall@t0:t1); disjoint bands stay cut (2013 VA14 60 kyr); off: every standing regime cut is a boundary (convention: an on/off of a geometry rule; a boundary separates two libration regions, the test adds no threshold of its own)
LIBRATION_REGIME_CUT_MARKS=True
# the center is the angle smoothed over this many cycles; also the MMR separatrix zone: its strength modulation (e and the varpi offset of the members) is read only from motion slower than this x the angle's own period (P_cyc, else the median turn), and a record shorter than twice that has a standing separatrix, zone [1, 1] (flag zone_external_unresolved) (convention)
LIBRATION_CENTRE_CYCLES=3.0
# floor of the prominence of a center turn (4x the center noise A/82) [deg]
LIBRATION_CENTRE_TP_PROMINENCE_DEG=10.0
# a center turn also needs this x the turning-point prominence
LIBRATION_CENTRE_TP_FACTOR=2.0
# MMR G2c: the analysis at the scale of the center takes its turning points at the center-turn prominence p_c (MMR_TP_PROMINENCE_FLOOR_DEG raised to p_c there): the turns the precheck that qualified the scale reads: a swing below p_c is no turn of the center there (residue of the fast component W_c attenuates, or a libration too small for this scale, which the fine scale judges) (2003 TX9 3E+2J-10); off: the floor of the fine scale
LIBRATION_CENTRE_SCALE_TP_AT_CENTRE=True
# MMR G2c guard: a reading at the scale of the center replaces the fine reading only when it is at least as well established as the resonance's own libration: when the fine pass reads the origin as dynamic and the center-scale analysis left it unknown on a leaf where a measurement contradicts it (5a, 5a*, 5b, 5e, 5f, 5g, 5o), the fine verdict stays and the center-scale reading is reported as the slow scale and in geo_cs_displaced_* (rule centre_scale_displaced; 709123 2J-1: the g - g5 wave of the center, leaf 5g, displaced the 2J-1 libration); a rule switch, no threshold; off: G2c always takes precedence
LIBRATION_CENTRE_SCALE_OBJECTION_GUARD=True
# W28 B7 (card g07-4 A), G2c scale ladder: the shorter cutoffs tried below a slow libration found at the center scale W_c, as fractions of P_slow / FILTER_MIN_LIBRATION_CUTOFFS (steps of sqrt 2, so neighboring rungs are close enough to compare); a rung is kept only above LIBRATION_CENTRE_CYCLES x P_fast (P_fast: the shortest full period of the fine turning points) and only when the W_c window holds fewer than LIBRATION_CENTRE_MIN_ESTIMATES slow periods; empty = off (385533 7N-12: 22.7 kyr -> 7.95 kyr) (convention)
MMR_SCALE_LADDER=0.71,0.5,0.35,0.25,0.18,0.125
# W28 B7, G2c scale ladder: a rung keeps the slow extrema of W_c and of the neighboring rung when, in their common window, the turning points at the center prominence agree in number and kind and each moves by at most this x P_slow (the 21 G2c rows of the benchmark: the largest shift on a rung that keeps the count is 0.022; a fast wave that reaches p_c adds turning points instead) (convention)
MMR_SCALE_TP_TIME_TOL=0.1
# a bounded center turning back this many times is modulated, not drift (secular and ZLK angles: once is enough under SECULAR_TURNING_CENTRE, ZLK_TURNING_CENTRE)
LIBRATION_CENTRE_RETURNS_MODULATED=3
# a stationary center needs this many independent full cycles (no shared half-cycle; every band overlapping); with fewer (3 TPs = one cycle, one center) the episode is accepted but its center is not measured (L6 thin)
LIBRATION_CENTRE_MIN_ESTIMATES=2
# modulated: range of the center below this [rad]
LIBRATION_MODULATED_RANGE_MAX_RAD=3.141592653589793
# a slip is a step of 2 pi (1 +- this) of the oscillation midpoint (convention)
LIBRATION_SLIP_TOLERANCE=0.2
# a slip faster than this x T0 is an unwrap error (the angle cannot pass the top faster)
LIBRATION_SLIP_MIN_DURATION_T0=0.5
# pattern A needs at least this many slips
LIBRATION_PATTERN_A_MIN_SLIPS=2
# without a measured zone, pattern-A pieces need this amplitude (J/J_s ~ 0.3) [deg] (convention)
LIBRATION_PATTERN_A_MIN_AMP_DEG=60.0
# pattern B: rate minimum within this of the potential top [deg]
LIBRATION_STALL_PHASE_TOL_DEG=30.0
# pattern B: this fraction of revolutions counts: the rate minimum at the top, slower than the rotating branch by LIBRATION_STALL_RATE_TOL and the top passage within reach of the separatrix zone (convention)
LIBRATION_STALL_REV_FRACTION=0.75
# pattern B: a revolution counts only when its slowest rate r_min is below r_pend(h), the min/mean rate of its own rotating branch at its energy, by more than this (every rotating branch is slowest at the top); the medians |r_min - r_pend| above it = stall_rate_inconsistent (flag); the former flag's tolerance (a branch at h = 1.14, r_pend 0.55, counts turns slower than 0.35 at the top) (convention)
LIBRATION_STALL_RATE_TOL=0.2
# drift: rejected centre_moves runs cover at least this fraction of the window
LIBRATION_DRIFT_MIN_WINDOW_FRACTION=0.5
# G4b: the angle circulates when the slow center advances by at least this many revolutions net over the window (|c(t1) - c(t0)| / 2pi), even when its largest monotone pass stays below one (a staircase with small step-backs); also in the angle word of K2 (142694 1V+3S-7 200 kyr, 2.75 rev: a circulation; 21028 7E-10M-6, 1.81 rev: a drift) (convention)
LIBRATION_CIRCULATION_NET_REV=2.0
# a jump candidate exceeds this many robust std of the slow-variable increments
LIBRATION_JUMP_NOISE_FACTOR=8.0
# a jump changes the cycle energy h by more than max(2 sigma_h, this)
LIBRATION_JUMP_DH_MIN=0.1
# cycles compared on each side of a jump candidate
LIBRATION_JUMP_CYCLES=2
# G2a (MMR, not 1:1): an accepted run whose half-amplitudes step between two separated bands, with the swing of a and the cycle energy changing the same way within one half-cycle, is cut there as at a confirmed jump of a (an impulse: a close encounter puts the orbit on another energy level; 2003 TX9 3E+2J-10 at the Mars encounters of 6.5-6.9 kyr); off: such a run stays one episode (convention)
LIBRATION_ACTION_STEP=True
# G2a: half-cycles on each side of the transitional half-cycle (2 = one closed cycle)
LIBRATION_ACTION_STEP_MIN_HALF_CYCLES=2
# G2a: the two bands of half-amplitudes are separated: the smallest on the larger side over the largest on the smaller side is at least this (an adiabatic decay needs an e-folding of 1.5 cycles to reach 2 across one excluded half-cycle)
LIBRATION_ACTION_STEP_SEPARATION=2.0
# G2a: ratio of the median half-amplitudes of the two sides
LIBRATION_ACTION_STEP_RATIO=3.0
# G2a: the swing of a (std of a_f on each side at the record's cutoff) changes the same way by at least this factor (delta a ~ sigma_dot; 74729 1J+6S-1: a sigma step that a does not show, ratio 0.37)
LIBRATION_ACTION_STEP_A_RATIO=1.5
# G2a: cycles of the energy analysis on each side that confirm the step (|dh| > max(2 sigma_h, LIBRATION_JUMP_DH_MIN), the sign of the amplitude change); fewer than LIBRATION_JUMP_CYCLES on a side makes the split provisional (cap action_step_provisional, confidence <= medium)
LIBRATION_ACTION_STEP_CYCLES=1
# G2a test 7: every disjoint cycle of both sides has T_obs/T_pred within this of 1, T_pred the period of the loop of the cycle's own energy, in the well that holds it, of V(sigma) fitted (as V_E) on the cycles of the larger swings (held out: each of them in V of the others); and the two sides' median periods differ by more than this (else one forcing frequency explains both: in a nearly harmonic V every loop has one period). As SEPARATRIX_PERIOD_TOL for R0
LIBRATION_ACTION_STEP_PERIOD_TOL=0.2
# G2a test 7: the observed extremes of sigma of every cycle lie within this x its half-swing of the turning points of the loop of its energy (a swing off the minimum of V is no libration in V). In the harmonic limit the half-width at a given energy scales as the period, so this equals LIBRATION_ACTION_STEP_PERIOD_TOL
LIBRATION_ACTION_STEP_TP_TOL=0.2
# G2a test 7: on each side the cycle energies in V spread by at most this x the step of the energy between the sides (between impulses the energy of a libration stays put; at 0.5 the two bands are apart by at least half the step, as the half-amplitude bands of LIBRATION_ACTION_STEP_SEPARATION)
LIBRATION_ACTION_STEP_ENERGY_DRIFT=0.5
# G2a test 7 holds at every shape cutoff C = f x the shorter side period of this list, with the same number of wells (the numbers reported at the middle one): a factor 2, lighter than SEPARATRIX_CUTOFF_CYCLES, since the test reads turning points and a second well, which live in the high harmonics of a swing across a barrier (a double well integrated and kicked: T_obs/T_pred 0.994 at 0.1, 0.911 at 0.2, the second well lost at 0.3); the rate's noise sets the floor (V_E R^2 >= SEPARATRIX_VE_R2_MIN). A well or a law one cutoff alone gives is the filter's
LIBRATION_ACTION_STEP_CUTOFFS=0.075,0.1,0.15
# G2a: the transitional half-cycle lasts at most this many of the shorter median full period of the two sides
LIBRATION_ACTION_STEP_MAX_PERIODS=1.0
# jump locator baseline tau >= this x P_c
LIBRATION_JUMP_TAU_CUTOFFS=2.0
# jump locator baseline tau >= this x the output step
LIBRATION_JUMP_TAU_STEPS=5.0
# a jump candidate needs max(tau, this x P_cyc) of the window on each side to be confirmed; closer to an edge it is kept as jump_at_edge and cuts nothing
LIBRATION_JUMP_EDGE_PERIODS=1.0
# turning-point prominence floor: twice the synodic leak after the filter [deg]
MMR_TP_PROMINENCE_FLOOR_DEG=1.0
# prominence >= this x the unremoved ripple half-amplitude or the part of sigma_f faster than MMR_LIBRATION_PERIOD_MIN_YR (95th percentile, the image of the libration runs through the two filters taken out first; a wave of half-amplitude r gives turns <= 2r)
MMR_TP_RIPPLE_FACTOR=4.0

# --- Energy relative to the separatrix (shared) and the numeric zone it reaches (MMR)
# harmonics of V(sigma): asymmetric external 1:N need 2
SEPARATRIX_HARMONICS_MAX=2
# the second harmonic is kept when R^2 of V_E grows by this
SEPARATRIX_HARMONIC_GAIN=0.2
# period-energy law: |median T_obs/T_pend - 1| <= this (pendula 0.9-1.1, kinematics 0.61)
SEPARATRIX_PERIOD_TOL=0.2
# fixed well: coherence of the stable point over windows (potential 0.95-0.99, kinematics 0.71)
SEPARATRIX_PHASE_COHERENCE=0.9
# R0 with the slow variable: correlation of V_E and V_F in a window
SEPARATRIX_VEVF_R_MIN=0.9
# R0 with the slow variable: fraction of the eligible windows where V_E ~ V_F (a window is eligible when sigma swings >= MMR_A_RESPONSE_MIN_AMP_DEG in it or turns; none eligible: not_measured)
SEPARATRIX_VEVF_FRACTION=0.666
# R0 with a: V_F fits c a_dot = -m V'(phi) + C and drops C (the fit before W28, for comparison). Off: no free constant (a periodic V has no mean force over a closed cycle; on a ~100-deg arc the constant is nearly collinear with the harmonics and moved 137295 1N-2's V_F well 279 -> 338 deg), and a moving frame subtracts its own acceleration s'' from c a_dot instead
SEPARATRIX_VF_FREE_CONSTANT=False
# R0 with a (the V_E ~ V_F correlation route, not the 1:1 energy integral): V_F must also carry the observed period, the median T_obs/T_pred(V_F) over the eligible compared cycles within SEPARATRIX_PERIOD_TOL of 1 (T_pred at the cycle's energy recomputed in V_F; a correlation does not see a scale factor between V_E and V_F: a force 10x too strong correlates 1.00 and gives a period law 3.4); no finite law: not_measured. Off: the correlation alone, for comparison
SEPARATRIX_VF_PERIOD_LAW=True
# R0 with a: V_E and V_F of a window are compared on the arc of phi the window visits (outside it both are extrapolations); off: on the full circle
SEPARATRIX_VEVF_ARC=True
# R0 with a: the visited arc of SEPARATRIX_VEVF_ARC is widened by this on each side (a full turn: the circle) [deg] (convention)
SEPARATRIX_ARC_PAD_DEG=0.0
# R0 with a: a window's V_E (and V_F with it) takes one more harmonic when that raises the held-out R^2 of rate^2 = 2E - 2V (fitted on one half of the window in time, predicted on the other, both ways) by this (over 6564 windows of 126 R0 rows the gain's median is 0.008, its 70th percentile 0.02; 137295 1N-2's asymmetric well gains 0.06-0.075; 0.01 and 0.02 give the same R0 everywhere there) (convention)
SEPARATRIX_HOLDOUT_GAIN=0.02
# margin in sigma_h when a cycle is put into a zone class
SEPARATRIX_SIGMA_MARGIN=2.0
# floor of the cycle-to-cycle energy scatter sigma_h
SEPARATRIX_SIGMA_FLOOR=0.02
# trend mechanism: slope of J/J_s over cycles significant at this many sigma
SEPARATRIX_TREND_SIGMA=3.0
# pulsation mechanism: cyclic-shift p-value below this (convention)
SEPARATRIX_PERMUTATION_P_MAX=0.05
# layer mechanism: crossings at an adiabaticity lambda above this are the chaotic layer's own (no adiabatic invariant)
SEPARATRIX_LAYER_ADIABATICITY_MIN=0.5
# near_separatrix_energy flag: revolutions within this many zone widths above the zone
SEPARATRIX_NEAR_ZONE_WIDTHS=1.5
# the mark exit_and_capture lifts the cap transient_unexplained: an angle that left its libration and came back is the transient the record shows even without a named mechanism (convention)
MMR_EXIT_AND_CAPTURE_LIFTS_UNEXPLAINED=True
# a 1:1 angle gets no cap transient_unexplained: the pendulum separatrix model that names a mechanism does not apply to it, its crossings are close encounters (2026 FW12) (convention)
MMR_COORBITAL_LIFTS_UNEXPLAINED=True
# V_E, V_F, the modulation and the zone read sigma and a smoothed at max(P_c, this x P_cyc) (G(P_cyc) 0.998)
SEPARATRIX_CUTOFF_CYCLES=0.2
# R0 is measured only when V_E explains this share of sigma_dot^2 within the cycles (convention)
SEPARATRIX_VE_R2_MIN=0.7
# zone the separatrix reaches: 'numeric' (modulated pendulum), 'eq_only', 'adiabatic'
MMR_ZONE_METHOD=numeric
# two-body angle with its planet saved: the energy of each turning point is read in the averaged potential at its own time, h = (<D>(sigma_TP) - <D>_min) / (<D>_barrier - <D>_min); at most this many evenly chosen turning points are evaluated (cost: one profile each, ~0.02 s), the others interpolated in time; as many even times of the record give the mean separatrix action <J_s> that carries their J/J_s(t) to the zone's J/<J_s>
MMR_SEPARATRIX_AVGPOT_TP_MAX=40
# smallest initial action J0/<J_s> of the zone grid
MMR_ZONE_J_MIN=0.1
# step of the zone grid in J0/<J_s> and in h0
MMR_ZONE_J_STEP=0.025
# largest initial energy h0 on the rotation side of the zone grid
MMR_ZONE_H_MAX=2.0
# start phases per modulation period in the zone grid
MMR_ZONE_PHASES=16
# relative tolerance of the DOP853 zone trajectories
MMR_ZONE_RTOL=1e-09
# below this adiabaticity the numeric zone is checked against the adiabatic edge
MMR_ZONE_ADIABATIC_LAMBDA_MAX=0.1
# numeric vs adiabatic J_lo differing by more = zone_numeric_mismatch
MMR_ZONE_ADIABATIC_TOL=0.05

# --- MMR physics: response of a, force law, identity, kinematics, slow libration
# below this amplitude sine and line differ < 10% (A^2/6): harmonic force law not_measured (not the 1:1 law) [deg] (convention)
MMR_A_RESPONSE_MIN_AMP_DEG=45.0
# R0 not measured over the record (one V_E pooled over every cycle mixes regimes) is read inside each accepted episode with two disjoint full cycles, at its own period and frame, thresholds unchanged; lift-only: pass when some episode passes and none fails
SEPARATRIX_R0_EPISODES=True
# force-law fit window in cycles (phase defined, force ~ constant)
MMR_FORCE_WINDOW_CYCLES=3.5
# step of the force-law windows as a fraction of the window
MMR_FORCE_WINDOW_STEP=0.5
# fewer force-law windows = not_measured
MMR_FORCE_MIN_WINDOWS=2
# force law passes with R^2 >= this in both halves (convention)
MMR_FORCE_R2_FULL=0.7
# force law fails with R^2 below this under both laws (convention)
MMR_FORCE_R2_FAIL=0.4
# floor of the expected spread of phi0 (the column rsp_phi0_tol_deg only) [deg]
MMR_FORCE_PHASE_TOL_DEG=30.0
# the multiplet law is taken when its R^2 exceeds the single one by this
MMR_FORCE_MULTI_GAIN=0.1
# multiplet law: coherence of the leading complex coefficients over windows
MMR_FORCE_COEF_COH_MIN=0.8
# the leading multiplet terms carry this share of the fitted power
MMR_FORCE_POWER_SHARE=0.8
# 'lattice' = a measured harmonic force law is not_measured (contamination) when a forced line of the angle's lattice lies within 1/(MMR_FORCE_WINDOW_CYCLES P) of 1/P (the fit cannot tell the two apart; it never makes a libration dynamic); 'off'
MMR_FORCE_CONTAMINATION=lattice
# identity, force law, potentials use sigma, a smoothed at max(P_c, this x P_cyc): derivatives amplify what P_c leaks; 0.1 keeps the cycle and its first 5 harmonics (G(2 cutoffs) = 0.94, as FILTER_MIN_LIBRATION_CUTOFFS) and costs an exact pendulum R^2 < 0.01 up to 178 deg; 0.15-0.2 bend the law near the separatrix (F[sin sigma] != sin F[sigma])
MMR_RESPONSE_CUTOFF_CYCLES=0.1
# harmonic force law (L4): a line of a_dot (not a harmonic P_e/k of the libration) with an amplitude of at least this x the force K of the first fit, in the series the law reads, raises the response cutoff of that measurement (2004 TK14 31M-34: 64 yr at 0.9 K; 433 Eros 47M-44: 83 yr at 1.5 K)
MMR_RESPONSE_LINE_AMP_FRAC=0.5
# such a line raises the response cutoff to this x its period (G = 0.16 of the line left in a, 2nd-order filtfilt)
MMR_RESPONSE_LINE_MARGIN=1.5
# the response cutoff raised by a line stays at or below the period of the measurement / this (P_e/4 keeps G = 0.996 of the cycle; a slower line is left in)
MMR_RESPONSE_MAX_FRACTION=4.0
# lines of a_dot are searched from this x the base response cutoff up to P_e/2: a line faster than the cutoff leaks through it (2004 TK14: 64 yr under a 75-yr cutoff keeps 0.9 K); below half the cutoff the filter leaves < 6 %
MMR_RESPONSE_LINE_BAND_CUTOFFS=0.5
# null test of a force law whose cutoff a line raised: R^2 of the same law with a_dot shifted in time (not wrapped) by this many lags (m + 1/4) P_e and (m + 3/4) P_e, alternately forward and back, m >= 1 whole periods spread up to half the record; its largest value is the null R^2 (whole or half periods alone keep a steady libration in phase)
MMR_FORCE_NULL_SHIFTS=8
# a force law whose cutoff a line raised passes only with R^2 at least this above the null R^2 (433 Eros 47M-44: 0.6-0.8 against 0.15-0.35) (convention)
MMR_FORCE_NULL_GAIN=0.2
# a failed or thin harmonic force law (L4) is fitted again with up to this many harmonics of the angle, a_dot = sum_k [A_k sin k sigma + B_k cos k sigma] + C, the force of the V(sigma) R0 fits (as SEPARATRIX_HARMONICS_MAX; a double well or a flat bottom): taken when N >= 2 gains MMR_FORCE_MULTI_GAIN, its coefficients are coherent (MMR_FORCE_COEF_COH_MIN), it beats the shifted null by MMR_FORCE_NULL_GAIN and the law fitted on the samples of the windows before the middle of their span predicts those after it (and the reverse) with R^2 >= MMR_FORCE_R2_FAIL; it lifts L4, never lowers it; 1 = off
MMR_FORCE_HARMONICS_MAX=2
# W28 B8 (card g07-2 A): where the harmonic force law (L4) fails or passes thin on a two-body, non-1:1 angle with a direct strength, the theoretical a_dot of the directly averaged disturbing function (the planet's real mass, each window's elements) and the observed a_dot, low-passed identically at MMR_DIRECT_FORCE_CUTOFF_CYCLES x P_large, are compared with one free scale s per window: it lifts L4 (cap force_law_theory_only, <= medium) when the smaller half R^2 >= MMR_FORCE_R2_FAIL (thin below MMR_FORCE_R2_FULL), every s lies in [1/sqrt(r), sqrt(r)] (r = MMR_STRENGTH_CHECK_RATIO), R^2 beats the time-shifted null by MMR_FORCE_NULL_GAIN and two windows share no sample; never lowers L4, never makes an episode (59358 8N-13: lattice line 13 P_N in a_dot)
MMR_DIRECT_FORCE_LAW=True
# direct force law: both a_dot are low-passed at this x P_large, and P_large is the fixed point of the period of the turns of sigma low-passed at this x P (keeps the cycle at G = 0.985, a line at P/2 at 0.81, removes faster lines that P_c lets through; 0.25 never leaves the 4.4-kyr period of 59358 8N-13, 0.35 and 0.5 reach its 8.8-kyr swing with the same verdict); the turns count as large when the TP count at twice the cutoff stays within MMR_FILTER_GUARD_TP_REL, and F then reads the strength of the large turns (convention)
MMR_DIRECT_FORCE_CUTOFF_CYCLES=0.35
# direct force law (cost): the averaged profile d<D>/dsigma is computed in at most this many windows, evenly chosen; every window reads the nearest one (each profile at most MMR_OWNER_POTENTIAL_MAX_KERNELS kernels)
MMR_DIRECT_FORCE_SNAPSHOTS=5
# the record itself lifts the cap short_period_aliased only when the fast residual of sigma_f (p95, flt_fast_residual_deg) is at most this x the decisive episode's median half-amplitude and the short-period scatter of a passes MMR_SHORT_PERIOD_A_RATIO; 0 = never: the record cannot bound a line folded into a, only a finely sampled pilot measures it (0.1 lifted it on 2004 TK14 31M-34 and 433 47M-44, whose verdicts the folded lines in a change) (convention)
MMR_SHORT_PERIOD_CAP_RATIO=0.0
# the cap short_period_aliased also on a circulation (angle word circulation, reason circulation or alias; kinematic_drift, no_resonant_potential and a circulation with forced-wave runs (F6, its failed identity reads a) keep it); off: a circulation reads neither the identity nor the force law, which the folded lines in a spoil, and the folded lines move sigma_f by <= 0.024 of a half-amplitude (47 fine reruns), so they cannot turn a libration into a circulation; the flag stays (1627 3V-4M-7, 285637 3M+7J-6, 1999 UQ 7E+2M-9) (convention)
MMR_SHORT_PERIOD_CAP_CIRCULATION=False
# flag a_short_period_scatter (a warning, no cap by itself) on a record whose step folds short periods: its short-period scatter of a (smp_da_short_period_au, periods below MMR_JITTER_BAND_YR) above this x the a half-excursion of the decisive episode (ep_a_excursion_meas_au); the folded lines reach the a-based checks (identity, force law) there (2003 TG2, 2004 TK14, 2003 UC22 and 433 lose their verdict with folded errors of 0.59-1.65 x that excursion, no row at <= 0.56 does). A proxy, not a bound: a line folded to centuries is nearly invisible to it. With MMR_SHORT_PERIOD_CAP_RATIO > 0 it also keeps the cap; the same comparison gates MMR_SHORT_PERIOD_A_UNMEASURED (convention)
MMR_SHORT_PERIOD_A_RATIO=0.5
# on a record whose step folds short periods (flag short_period_aliased), a failed force law (L4) and identity (L3), which read a, count as not_measured in the status tree and the confidence when the strength by direct averaging passes and the short-period scatter of a exceeds MMR_SHORT_PERIOD_A_RATIO x the decisive a half-excursion; a fail never becomes a pass and the cap stays (433 47M-44, 2003 UC22 16M-27 and 2004 TK14 31M-34 at 5 yr keep their verdict at 0.5 yr, where L3 and L4 pass; 2001 ND13 1V-3, scatter 0.09, keeps its failed L4, which its fine rerun confirms) (convention)
MMR_SHORT_PERIOD_A_UNMEASURED=True
# harmonics m / P (m = 1..this) of P_orb and of the P_syn of the angle's planets that the step may fold: a line folded slower than the angle's period floor (smp_folded_slowest_yr) sets the flag and the cap short_period_aliased also below the fundamental step min(P) / 2 (P_orb 12 yr at a 5.999-yr step folds its second harmonic to 36 kyr). Only m <= this is searched: P_orb 12 yr at 4.002 yr folds its third harmonic to 8 kyr and stays unflagged at 2 (the record bounds no harmonic's amplitude, so the count is a convention); 0 = the fundamental step alone (convention)
MMR_SHORT_PERIOD_HARMONICS=2
# co-orbital (1:1) law: points of the theta grid and of the trapezoidal average over the planet's longitude (720 = 0.5 deg; the average converges at 360, the grid interpolates the near-encounter peaks to ~5 % rms)
MMR_COORBITAL_GRID_POINTS=720
# co-orbital law (memory): the tables of the averaged potential kept for the analysis of one record, in bytes of their arrays (17.3 kB each at 720 points: 140 MB hold 8101); a table beyond them is computed again when a later pass needs it (2010 CG236 over 20 kyr needs 7909, 137 MB, at 7 ms each). A bound in bytes holds at any MMR_COORBITAL_GRID_POINTS. It bounds this store only, not the process: the shared cache of 512 tables, the figure and the FFT workspaces come on top, and a process keeps the memory of its largest record (the benchmark tools recycle their workers, reclassify --tasks-per-worker) [MB]
MMR_COORBITAL_RECORD_TABLES_MB=140.0
# co-orbital law: the direct term is softened at this many Hill radii a_P (mu/3)^(1/3), so that an exact orbit crossing stays finite (the averaging does not describe the motion inside the Hill sphere; at 1 r_H the fitted K / K_theory of close-approaching horseshoes rises by 10-20 %, at 0.1 it is within 2 % of no softening)
MMR_COORBITAL_SOFTENING_HILL=0.1
# co-orbital law: a new table of the averaged potential when the eccentricity vector e exp(i omega) of the body or the planet moved by more than this
MMR_COORBITAL_RETABULATE_E=0.005
# co-orbital law: a new table when the inclination vector sin i exp(i Omega) of the body or the planet moved by more than sin of this [deg]
MMR_COORBITAL_RETABULATE_INC_DEG=0.5
# co-orbital law passes only with the fitted force K / K_theory in [1/this, this] (K_theory = 1: the model holds the planet's mass; a negative K pushes a the wrong way) (convention)
MMR_COORBITAL_SCALE_RATIO_MAX=3.0
# identity: |slope/c - 1| <= this
MMR_IDENTITY_SLOPE_TOL=0.2
# identity: correlation of sigma_dot and a >= this
MMR_IDENTITY_CORR_MIN=0.9
# an accepted episode whose period sits on a forced line of the lattice is a forced wave, no episode of the angle, even when its identity does not fail (the line alone); off: the line needs the failed identity, since a chance coincidence with a line happens for 6-17 % of the force laws (482824 19N-32: line 3N-5 with the identity passing at slope/c 1.00) (convention)
MMR_FORCED_WAVE_LINE_ALONE=False
# marking only (W28 B2): on a row that rule 5s decided (non_resonant/implausible_strength) every accepted episode is stored as a forced wave with the route strength (episodes.csv forced_wave, the figure): its period needs a force >= MMR_STRENGTH_IMPLAUSIBLE_RATIO x the one the disturbing function gives, so it is no libration of this angle; the name of that ground, not a driver found. Nothing is measured again: status, word, reason and level are the same either way
MMR_FORCED_WAVE_STRENGTH=True
# W31 (the author, three B): an accepted episode below MMR_A_RESPONSE_MIN_AMP_DEG is a forced wave when, at its own period, the envelopes of sigma and a inside it stay within the band the same steady wave shows around it (`mmr.background_wave`): a libration adds its own swing, a forced wave runs on unchanged. Every counted episode forced: veto forced_wave; some: they leave the count. Not for a 1:1 angle
MMR_FORCED_WAVE_BACKGROUND=True
# the background of the forced-wave test reaches this many of the episode's periods on each side (6 also took 2010 TU54, 30 lost 46596 ep 8 and 719 ep 3: the W31 measurement) (convention)
MMR_FORCED_WAVE_REFERENCE_PERIODS=12.0
# the background of the forced-wave test must hold at least this many periods outside every accepted run, else not measured (convention)
MMR_FORCED_WAVE_MIN_REFERENCE_PERIODS=4.0
# the band of the background wave's envelope the episode must stay in: its quantiles 1 - q and q, widened by CONFIDENCE_THIN_BAND (convention)
MMR_FORCED_WAVE_ENVELOPE_QUANTILE=0.9
# W28 B6b: an accepted episode with half-amplitude below MMR_A_RESPONSE_MIN_AMP_DEG (L4 and R0 not measurable) whose identity does not pass (fails or not measured), on a record whose slow center turns back once or twice within one revolution (an unfinished slow swing), is an unconfirmed ripple, no episode of the angle (episodes.csv forced_wave unconfirmed_ripple): G5a/G6 read the slow center (insufficient_time, extend). Never a record-covering episode nor a 1:1 angle; a real small libration keeps its passing identity (2004 YG1 9M-10J-4)
MMR_RIPPLE_ON_ARC=True
# W28 B6c, G5w: a slow center that turns back twice within one revolution, whose half-swing between the turns passes the slow identity and whose a swing and period 2 (t2 - t1) agree with the directly averaged pendulum at its amplitude within sqrt(MMR_STRENGTH_CHECK_RATIO), is an unfinished slow libration: insufficient_time/arc, not drift nor few_cycles (523683 2U-9); unmeasured (one turn, three-body, 1:1) keeps the old reading (the drift of 101703 and 142694 1V+3S-7)
MMR_SLOW_SWING_IN_WELL=True
# W28 B10a (cards g08-7, g05-2): store the slower libration of the center at its own scale: the runs G2c finds at the center scale W_c (covering the record or not; episodes.csv scale=slow), else the turns of the slow center of a librating angle; its period, cycles, identity, B1, nearest secular period and cause with a level (identified / possible / unknown; columns slow_*). A description: only K3s reads it
MMR_SLOW_SCALE_REPORT=True
# W28 B10a K3s (card g08-8 A): a non_resonant circulation whose slow scale has the period of a secular cycle (pi/|omega_dot| or 2 pi/|g - g_j| within MMR_KIN_PERIOD_TOL) and fails its own identity is a kinematic libration (origin_detail secular_cycle), whatever B1 or a thin L4; the status and a libration row never change (37087 3J+8S-3); needs MMR_SLOW_SCALE_REPORT
MMR_SECULAR_CYCLE_KINEMATIC=True
# a carries < this of the needed amplitude: the oscillation sits in the varpi part
MMR_B1_RATIO_MIN=0.1
# B1 compares a and sigma_dot / |c| in the band [P/f, f P] around the cycle period P (the libration and its wandering period; the identity holds there harmonic by harmonic) (convention)
MMR_B1_BAND_FACTOR=2.0
# kinematic: slow sigma follows p varpi with correlation >= this (convention)
MMR_KIN_CORR_MIN=0.9
# kinematic: slow a_dot answers sin sigma_slow with R^2 <= this (convention)
MMR_KIN_SLOW_R2_MAX=0.2
# independent points (length / center window) needed for the kinematic correlations: K1's slow angle and K2's slow
# center ((window - 2 W_c) / W_c); fewer, and the correlation is not measured
MMR_KIN_MIN_POINTS=3
# origin_detail: the angle period matches the e-cycle, the 2 omega cycle or a planetary ripple within this fraction
MMR_KIN_PERIOD_TOL=0.1
# kinematic drift of the slow center (K2): the largest swing of a librating episode (2 x its largest half-amplitude) stays below this x the range of the slow center, so the episodes are a ripple on the drift, not the libration (21028 7E-10M-6: 117 deg against 741 deg, 0.16; the Hilda 153 3J-2: 0.95) (convention)
MMR_KIN_RIPPLE_SHARE_MAX=0.5
# a verdict non_resonant/kinematic_drift of K2 reports the angle word of its slow center, not of the ripple the geometry reads as episodes: drift, or circulation when the center passes a revolution in one direction (G4) (21028 7E-10M-6: a drift; 2897 35S-4: 10.8 rev, a circulation); off: the geometry word (episodic) stays (convention)
MMR_KINEMATIC_DRIFT_WORD=True
# a kinematic libration (step 3, B1 or the kinematic cycle) whose decisive episode moves its center by more than this x its mean amplitude (L6) is decided as K2: non_resonant/kinematic_drift with the slow center's word, drift or circulation (62243 1M-4J-1, L6 1.82: a drift) (convention)
MMR_KIN_DRIFT_SHIFT_RATIO=1.0
# K1e, the measured physics of a kinematic libration: a carries less than this of the amplitude a pendulum would need (B1 ratio), with the episode's sigma following p varpi (K1 on the episode >= MMR_KIN_CORR_MIN) and its period at a secular one (within MMR_KIN_PERIOD_TOL); then the kinematic verdict may reach high. Far below MMR_B1_RATIO_MIN: a flat a, not a weak pendulum (285637 3M+7J-6: 6e-5; 481085 7E-10M-6: 3.2e-3; 41588 3J+9S-2: 0.095 stays medium) (convention)
MMR_KIN_B1_CLEAR=0.01
# slow libration excluded with a full margin: center rate >= this x the bound
MMR_B5_RATIO_FULL=2.0
# exact commensurability: |nu_c| < this x its error
MMR_B5_EXACT_SIGMA=2.0
# C4 full: <|sigma_dot|> / (2 omega0_K) >= this
MMR_C4_RATIO_FULL=1.5

# --- MMR subresonances of the multiplet and the owner search
# (the members scanned and listed go up to degree MATRIX_2BODY_ORDER_MAX / MATRIX_3BODY_ORDER_MAX; degree = sum of
# |slow coefficients|, the power of e, e_P, sin i/2 of the term)
# test E': a member's d'Alembert factor prod x^|c| (x = e, e_P, sin i/2, sin i_P/2) is at least this x that of the strongest term of the same commensurability (its pendulum is then <= 1/sqrt(this) ~ 30 times slower)
MMR_SUBRESONANCE_STRENGTH_REL_MIN=0.001
# members with node coefficients are enumerated when the median inclination to the invariable plane reaches this (their factor against the planar one of the same degree is (sin(i/2) / e)^2) [deg]
MMR_SUBRESONANCE_NODAL_INC_MIN_DEG=10.0
# candidate: its center range <= this x the range of the catalog angle center
MMR_SUBRESONANCE_RANGE_RATIO=0.5
# candidate: |center rate| <= max(2 sigma_rate, this) [rad/kyr]
MMR_SUBRESONANCE_RATE_FLOOR_RAD_KYR=0.02
# candidate: largest monotone center pass below this [rad]
MMR_SUBRESONANCE_PASS_MAX_RAD=3.141592653589793
# test A: phi0 coherence of the force law relative to the subresonance
MMR_SUBRESONANCE_PHI0_COH_MIN=0.8
# test A: and higher than for the catalog angle by this
MMR_SUBRESONANCE_PHI0_COH_GAIN=0.2
# test B: mean center within this of 0 or pi [deg]
MMR_SUBRESONANCE_CENTRE_TOL_DEG=30.0
# test B is skipped above this eccentricity
MMR_SUBRESONANCE_CENTRE_E_MAX=0.3
# test B is skipped above this inclination [deg]
MMR_SUBRESONANCE_CENTRE_INC_MAX_DEG=20.0
# test C: center ranges within this fraction tie; also the tie band of the theory choice (A6b: theoretical center ranges within it, W decides)
MMR_SUBRESONANCE_TIE_FRACTION=0.2
# test D: compare with the composite multiplet theory (confidence only: D never rejects a subresonance)
MMR_SUBRESONANCE_THEORY=True
# test D: RMS of the center about pi - arg P(beta); the theory chooses the member (A6b) only when the measured center follows it this closely [deg]
MMR_SUBRESONANCE_THEORY_RMS_DEG=20.0
# test D: and <= this x the RMS of the best rival single-member hypothesis (sigma0 in, the accepted member out)
MMR_SUBRESONANCE_THEORY_SINGLE_RATIO=0.5
# test D: the accepted one has the largest coefficient or within this of it
MMR_SUBRESONANCE_THEORY_COEF_FRACTION=0.2
# test D: correlation of the period with T0(t) F(A)
MMR_SUBRESONANCE_PERIOD_CORR_MIN=0.8
# test D: median observed/predicted period within this factor
MMR_SUBRESONANCE_PERIOD_RATIO_MAX=2.0
# test E: predicted T0 <= this x the observed period (is a resonance at all)
MMR_SUBRESONANCE_T0_RATIO_MAX=2.0
# trigger T2: a responds (R^2 >= this) ...
MMR_SUBRESONANCE_T2_R2_MIN=0.4
# trigger T2: ... but the phi0 coherence is below this
MMR_SUBRESONANCE_T2_COH_MAX=0.7
# support T3: drift rate matches a secular combination within this sigma
MMR_SUBRESONANCE_T3_SIGMA=2.0
# support T3: or within this fraction of the drift rate
MMR_SUBRESONANCE_T3_RATE_FRAC=0.25
# length of the ranked list sub_top; subresonances written to candidates.csv in top mode
MMR_SUBRESONANCE_TOP_N=10
# the scan window is the longest stretch of the run whose full periods stay <= this x their median (the slow cycles at the run edges are near the separatrix of the modulated pendulum, where no center is stationary)
MMR_SUBRESONANCE_CYCLE_PERIOD_RATIO=2.0
# with the nodal members (inclination >= MMR_SUBRESONANCE_NODAL_INC_MIN_DEG) the members sigma +- 2 m omega (omega = varpi - Omega), m = 1..this, are scanned and listed whatever their degree (2003 UG22 10E-17+0+7: sigma + 2 omega has degree 11); 0 = none beyond the degree limit (convention)
MMR_SUBRESONANCE_OMEGA_HARMONICS=2
# the ranked list marks the d'Alembert factor unreliable above this eccentricity (display only, sub_strength_caveat) (convention)
MMR_SUBRESONANCE_DALEMBERT_E_MAX=0.2
# the ranked list marks the d'Alembert factor unreliable above this inclination to the invariable plane (display only) [deg] (convention)
MMR_SUBRESONANCE_DALEMBERT_INC_MAX_DEG=20.0
# a center moves over an accepted episode when its travel exceeds this x the episode median half-amplitude: trigger T7 (the multiplet theory's center of the catalog member, two-body), the geometric part of the diagnostic trigger T8 (the observed center shift while the bands overlap; 2003 ND 61 against 55 deg) and the composite reading of A6b (no planar member's theoretical center stands) (convention)
MMR_SUBRESONANCE_CENTRE_MOVE_RATIO=1.0
# 'auto' = search the owner by the rules (always when the force law is not_measured); 'off'
MMR_OWNER_SEARCH=auto
# planets of the owner candidates
MMR_OWNER_PLANETS=Venus,Earth,Mars,Jupiter,Saturn,Uranus,Neptune
# largest planet coefficient of a two-body owner
MMR_OWNER_COEF_MAX=60
# largest order of a two-body owner (owners of 7-17 were seen)
MMR_OWNER_ORDER_MAX=20
# largest |coefficient| of a three-body owner
MMR_OWNER_COEF_MAX_3B=12
# owner candidate: |rate| <= this x 2 pi / min(P_a, P_cyc) somewhere in the a range of the record
MMR_OWNER_RATE_FACTOR=1.5
# owner accepted: median R^2 of a_dot on its angle in the windows of one regime (0 false owners on 29 measurable own librations at any value 0.5-0.95 with the ripple test; GK3 and 117306 are lost at 0.9, YG4 at 0.95) (convention)
MMR_OWNER_R2_MIN=0.7
# owner accepted: phi0 coherence
MMR_OWNER_PHI0_COH_MIN=0.8
# owner accepted (route r2): R^2 above that of the angle itself by this; routes phase and potential are the alternatives
MMR_OWNER_R2_GAIN=0.2
# owner accepted (route phase): its phi0 coherence C_B >= L_owner + this, L_owner = |<exp(i Psi_w / v)>| the most it could have if sigma's own term drove a, while sigma's C_sigma < L_sigma + this (L_sigma = |<exp(i Psi_w / u)>|, corrected for the owner's slips); L_owner > 1 - this: phase_unresolved (at small amplitude both angles fit a_dot by the identity sigma = (v/u) phi_o + Psi/u)
MMR_OWNER_PHI0_COH_GAIN=0.2
# owner test: a_dot band [P/f, f P] around the a-wave period P; P is searched within a factor f of P_cyc; force-law windows keep MMR_OWNER_BAND_EDGE_TRIM x f P from the record ends
MMR_OWNER_BAND_FACTOR=2.0
# owner test: the force-law windows keep this x f P (the band's longest period) from either end of the record (2 P at f = 2; conservative, the trim before 2026-11-05); stage 3 of the search uses MMR_OWNER_FITTED_EDGE_TRIM (convention)
MMR_OWNER_BAND_EDGE_TRIM=1.0
# owner search, stage 3 (too few windows at MMR_OWNER_SHORT_WINDOW_CYCLES): the trim x f P; measured 2026-11-05 (order-2 band [P/2, 2P]): the band-pass edge error falls to its interior level (0.14 of the wave) at 0.75 P = 0.375 f P from an end
MMR_OWNER_FITTED_EDGE_TRIM=0.375
# owner search, stage 3: MMR_FORCE_MIN_WINDOWS windows are fitted to the span left by MMR_OWNER_FITTED_EDGE_TRIM, each at most MMR_OWNER_SHORT_WINDOW_CYCLES and at least this many periods (1.5 x 1.5 + 1.5 trimmed = 3.75 P of record); flag owner_fitted_windows; the sine fit (sin, cos, 1) separates from one cycle, half a cycle of margin; 0 = off (the author 2026-11-05: 385458 9N-17, 4.6 cycles) (convention)
MMR_OWNER_FITTED_MIN_CYCLES=1.5
# owner rejected as a ripple: sigma below the owner's band turns back in the regime's windows with a prominence of at least this x the band's peak-to-peak, more than a circulating owner can move it
MMR_OWNER_RIPPLE_FACTOR=2.0
# owner accepted: fast share of the remainder psi below this
MMR_OWNER_PSI_SHARE_MAX=0.1
# order-of-magnitude band of K_o / (2 |k| n a prod mu): orders the owner candidates and qualifies owner_probable; never accepts or rejects an owner (mu e^q is no bound)
MMR_OWNER_STRENGTH_MARGIN=10.0
# owner candidates written to candidates.csv
MMR_OWNER_TOP_N=5
# owner phase test: 'multiplet' = where the single phi0 drifts, fit phi_o + j (varpi - varpi_P), j from 0 to -p, with constant coefficients (R^2 >= MMR_OWNER_R2_MIN, coefficient coherence >= MMR_OWNER_PHI0_COH_MIN); 'single' = phi0 only
MMR_OWNER_LAW=multiplet
# owner search: when sigma has fewer than MMR_FORCE_MIN_WINDOWS windows of MMR_FORCE_WINDOW_CYCLES x P inside the band-pass edges (owner_too_few_windows: ~9.25 P of record), the search is run again with force windows of this many cycles (2 x 1.5 + 4 trimmed = 7 P of record), flag owner_short_windows; a multiplet keeps its modulation-period windows; 0 = off (W33, the author and Codex: 385533 7N-12 over 8.1 P) (convention)
MMR_OWNER_SHORT_WINDOW_CYCLES=2.0
# an accepted owner takes an episode of sigma (origin induced) only when its intervals (the windows of its passing regimes, libration or admissible forced wave; no bridge between them) cover at least this fraction of it, checked on every accepted episode (for a libration over the record or no episode: the analysis window); the own episodes decide the status, none induced -> origin none, flag owner_outside_episode (rule F7) (convention)
MMR_OWNER_COVER_MIN=0.5
# P2: an owner accepted in its libration regime makes an episode of sigma only when Psi/u = sigma - (k/k_o) phi_o turns by less than this per cycle of the episode (|own_psi_rate| x P_episode / 2 pi); 1 = a closed cycle of sigma cannot hold more than one turn of the remainder (a physical limit, not a convention); else that episode is not induced, flag owner_psi_too_fast. Forced-wave owners are not tested
MMR_OWNER_PSI_TURNS_PER_CYCLE_MAX=1.0
# owner route 'potential': 'auto' = a two-body candidate with the planet's saved elements may be accepted when its directly averaged force (2 k_o / (n a)) G m_P d<D>/dphi_o, band-passed as a, explains a_dot (R^2 >= MMR_OWNER_R2_MIN, every window scale s in [1/MMR_OWNER_POTENTIAL_SCALE_MAX, MMR_OWNER_POTENTIAL_SCALE_MAX]); 'off'
MMR_OWNER_POTENTIAL=auto
# owner route 'potential': the fitted amplitude scale s of the predicted a_dot lies within [1/x, x] in every window (x = 2: the owner supplies at least half the force; the model error of the frozen average is ~0.1) (convention)
MMR_OWNER_POTENTIAL_SCALE_MAX=2.0
# margin W of an owner accepted by 'potential': full when its scale range lies within [1/x, x] and R^2 >= MMR_W_R2_FULL, else thin (convention)
MMR_OWNER_POTENTIAL_SCALE_FULL=1.5
# owner route 'potential': the averaged force is evaluated in at most this many of the regime's windows, evenly chosen
MMR_OWNER_POTENTIAL_SNAPSHOTS=5
# owner route 'potential' (cost): tried on the best this many candidates by R^2 that pass R^2, psi share and the ripple test, when no candidate was accepted by R^2 or phase (the accepted owner gets it too, for its columns)
MMR_OWNER_POTENTIAL_TOP_N=3
# owner route 'potential' (cost): one profile <D>(phi_o) on L nodes per turn evaluates |k_o| L^2 kernels (L values of phi_o, |k_o| L nodes each); skipped (reason potential_cost) when the next L would exceed this (about 5 ns per kernel: 1e8 is ~0.5 s per profile, at most MMR_OWNER_POTENTIAL_SNAPSHOTS x MMR_OWNER_POTENTIAL_TOP_N profiles per row)
MMR_OWNER_POTENTIAL_MAX_KERNELS=100000000.0
# a two-body owner accepted by R^2 or phase must also agree with its directly averaged force where that is measured: every window K/K_direct within [1/MMR_OWNER_POTENTIAL_SCALE_MAX, MMR_OWNER_POTENTIAL_SCALE_MAX] and |phi0 - phi0_direct| <= MMR_OWNER_POTENTIAL_PHASE_MAX_DEG, else rejected (potential_unconfirmed); off = columns only (convention)
MMR_OWNER_POTENTIAL_CONFIRM=False
# MMR_OWNER_POTENTIAL_CONFIRM: the largest |phi0 - phi0_direct| of the fitted and the directly averaged force [deg] (convention)
MMR_OWNER_POTENTIAL_PHASE_MAX_DEG=20.0
# second capture: Psi = u sigma - v phi_o is low-passed at this many owner-band periods P (its slow part: the owner's wave cancels in Psi, what is left is the separation of the two resonances); the filter edges are trimmed
MMR_OWNER_CAPTURE_LOWPASS_PERIODS=3.0
# second capture (sigma held by its own term while the owner pins phi_o) is excluded when x = Psi_slow / u sweeps at least this and x_dot^2 is not a function of x (R^2 on [1, cos x, sin x, cos 2x, sin 2x] < MMR_OWNER_R2_MIN); otherwise unresolved (flag second_capture_unresolved, confidence <= medium); confirmed (W28 A2b, card g05-8: both resonances at once, origin joint, the row keeps its own reading) only when x sweeps less than this, with x_dot^2 and x_ddot functions of x (R^2 >= MMR_OWNER_R2_MIN), a period of x off every secular one (pi/|omega_dot|, 2 pi/|varpi_dot - g_j|, harmonics up to MMR_OWNER_CAPTURE_HARMONICS) by more than MMR_KIN_PERIOD_TOL and at least LIBRATION_CENTRE_MIN_ESTIMATES closed cycles of x (its turns at LIBRATION_CENTRE_TP_PROMINENCE_DEG); one cycle: uncertain [deg] (convention)
MMR_OWNER_CAPTURE_SWEEP_DEG=180.0
# second capture: the energy integral x_dot^2 = 2E - 2V(x) is fitted with the harmonics 1 .. this of x (V periodic in x; 2 = [1, cos x, sin x, cos 2x, sin 2x]) (convention)
MMR_OWNER_CAPTURE_HARMONICS=2
# second capture, second exclusion route (F3, card g05-6): excluded also when x_ddot follows the secular cycle (R^2 on the harmonics of 2 omega or of varpi - g_j t >= MMR_OWNER_R2_MIN) and not x itself (R^2 of x_ddot on [1, sin x, cos x] below this): x is pushed by the secular cycle, not held by a potential of its own (78085 5J-4S-1: 0.96 against 0.01) (convention)
MMR_OWNER_CAPTURE_SELF_R2_MAX=0.2
# second capture: a period of x = Psi_slow / u (columns own_x_*, from the low-pass cut MMR_OWNER_CAPTURE_LOWPASS_PERIODS x P up) and a secular term of route F3 or of the cause of the slow x are read only when this many of their cycles fit in the test span (over less, cos and sin of a nearly uniform phase are a low polynomial in t and fit any slow trend) (convention)
MMR_OWNER_X_MIN_CYCLES=2.0
# second capture: the energy fit needs at least this many samples per fitted term (after the filter edges are trimmed), else the block is not measured
MMR_OWNER_CAPTURE_SAMPLES_PER_TERM=3
# display only (the figure's owner lines): the model error of the frozen first-order average (Codex scatter 0.90-1.12 of s); a bound on sigma's own force max |s - 1| below it is printed as this value ('model limit') and the own period bound is taken at it (convention)
MMR_OWNER_POTENTIAL_MODEL_ERROR=0.1
# owner route 'identity': tried on a librating three-body angle without an accepted owner whose period needs at least this many times mu_i mu_j e^q (str_ratio, before the small-divisor envelope) (convention)
MMR_OWNER_IDENTITY_RATIO_MIN=1000.0
# owner route 'identity': on sigma's decisive window sigma_f = c phi_f + a + b t with |c / (k_sigma / k_phi) - 1| at most this (the exact identity passes it for almost any unwrapped candidate: phi librating there and its strength decide) (convention)
MMR_OWNER_IDENTITY_COEF_TOL=0.05
# owner route 'identity': rms of sigma_f - (k_sigma / k_phi) phi_f about its line on sigma's decisive window, over sigma's median half-amplitude, at most this (convention)
MMR_OWNER_IDENTITY_RESID_MAX=0.1
# owner route 'identity' (cost pre-filter): only a candidate whose low-passed phi_f spans less than this on sigma's decisive window is analyzed in full (a phi running a full turn there does not librate about a fixed center) [deg]
MMR_OWNER_IDENTITY_SPAN_MAX_DEG=360.0
# owner route 'identity' (cost): at most this many candidates passing the identity numbers, smallest phi_f span first, get their own full analysis (libration, cover of the window, direct-averaging strength)
MMR_OWNER_IDENTITY_TOP_N=3
# display only (the figure's owner lines): the linear forced-wave amplitude delta a = K / nu holds when the owner's rate |nu| is at least this many times its own small-amplitude frequency omega0 (nu >> omega0) (convention)
MMR_FORCED_WAVE_LINEAR_RATIO=2.0

# --- MMR strength (support only)
# the e^q order-of-magnitude strength scale is used only when the median e of the record is below this and the body's radial range crosses no planet of the term; the same median e enters e^q
MMR_STRENGTH_E_MAX=0.3
# check_mmr_strength passes when required/theory is within [1/x, x]: two-body, the range over the snapshots of the directly averaged theory whose observed swing lies in the well overlaps it (none: fail); three-body, required / mu e^q (legal e^q only, a scale, not a bound, support only); 1:1: not_applicable, its scale is judged by MMR_COORBITAL_SCALE_RATIO_MAX
MMR_STRENGTH_CHECK_RATIO=10.0
# implausible_strength: required/theory >= this or <= 1/this (two-body direct averaging; with the e^q scale of three-body terms, whose f(alpha) reaches ~1e2 (2003 EH16 1M-3J-1: 254), the lower side only with legal e^q); rule 5s: a librating angle for which neither L4 nor R0 passes (a measured failure included) and whose period needs >= this x a computed strength is non_resonant (two-body direct averaging or the harmonic, a center outside the well excluded unless MMR_STRENGTH_FIRST_OUTSIDE_WELL; three-body only with legal e^q and when required / (mu e^q B^2) of the small-divisor envelope stays >= this too)
MMR_STRENGTH_IMPLAUSIBLE_RATIO=1000.0
# two-body strength: the averaged disturbing function is evaluated with the simultaneous elements of the body and the planet at this many evenly spaced times inside the decisive episode; the check reads the range over them
MMR_STRENGTH_SNAPSHOTS=3
# two-body strength without the planet's saved elements: its mean J2000 orbit turned about the ecliptic pole by this many evenly spaced angles (its perihelion and node phase is unknown), all in the range
MMR_STRENGTH_UNSAVED_PLANET_PHASES=4
# two-body strength: trapezoidal nodes per turn of the planet's longitude in the average at fixed sigma (doubled until the curvature with half of them agrees within MMR_STRENGTH_QUADRATURE_TOL)
MMR_STRENGTH_NODES_PER_TURN=720
# two-body strength: the largest number of nodes per turn; not converged there = not measured (nearly crossing orbits)
MMR_STRENGTH_MAX_NODES_PER_TURN=5760
# two-body strength: points of the coarse sigma grid that finds the wells of <R>
MMR_STRENGTH_SIGMA_GRID=72
# two-body strength: the curvature at the center is the quadratic fit over +- this (the 1:1 tadpole 9/4 is 0.08 % off at 2 deg, 0.5 % at 5 deg) [deg]
MMR_STRENGTH_FIT_HALF_WIDTH_DEG=2.0
# two-body strength: the curvature is converged when the half-node quadrature agrees within this relative difference
MMR_STRENGTH_QUADRATURE_TOL=0.02
# two-body strength: at the center the body must stay this many Hill radii a_P (mu/3)^(1/3) from the planet along the average, else the averaged problem does not hold there (an encounter) and the strength is not measured
MMR_STRENGTH_MIN_DISTANCE_HILL=3.0
# two-body strength where double precision cannot resolve the well (no stable center, no converged curvature, or a curvature below MMR_STRENGTH_DOUBLE_FLOOR x |D0|): 'auto' = mu_P a 2|C| of the resonant harmonic C in extended precision (mpmath; method direct_harmonic); 'off' = not measured, as before
MMR_STRENGTH_MP=auto
# two-body strength in extended precision: decimal digits of the first attempt (doubled up to MMR_STRENGTH_MP_DPS_MAX while |C| / |D0| < 10^(MMR_STRENGTH_MP_GUARD_DIGITS - dps))
MMR_STRENGTH_MP_DPS=60
# two-body strength in extended precision: the largest number of digits; a harmonic still unresolved there is not measured (precision_exhausted)
MMR_STRENGTH_MP_DPS_MAX=130
# two-body strength in extended precision: digits kept beyond the cancellation log10(|D0| / |C|) of the sum
MMR_STRENGTH_MP_GUARD_DIGITS=15
# two-body strength in extended precision: trapezoidal nodes of the body's mean anomaly; the twin grid shifted by half a node must agree within MMR_STRENGTH_QUADRATURE_TOL
MMR_STRENGTH_MP_NODES_BODY=512
# two-body strength in extended precision: trapezoidal nodes of the planet's mean longitude (the same twin check)
MMR_STRENGTH_MP_NODES_PLANET=128
# two-body strength: a double-precision curvature of <D> below this x |D0| is rounding, not a well (the quadratic fit over +-2 deg divides the 1e-16 rounding of <D> by ~1e-3 rad^2); the harmonic in extended precision is used instead (numerical, not a convention)
MMR_STRENGTH_DOUBLE_FLOOR=1e-12
# rule 5s (implausible strength) runs before the other step-5 leaves (5a and its variants, 5e, 5g, 5u) for a librating angle whose force law and potential with a do not pass; with this off a two-body strength whose observed swings all lie outside the theoretical well (centre_outside_well) keeps the old order and reaches 5s only inside the branch where L4 and R0 are both not measured (129772 4N-7, 145480 1N-4 1 Myr, 719 36J-13) (convention)
MMR_STRENGTH_FIRST_OUTSIDE_WELL=False
# moving center: the most nodes of the track c(t) of the averaged-potential minimum along a record; the node step is max(P_c, span / this). Numerical resolution, not a threshold: the well moves on secular time scales (2013 AS27 31E-36: 56 deg in 20 kyr, 0.2 deg per node), c(t) is interpolated linearly between nodes
MMR_CENTRE_TRACK_NODES=400

# --- MMR margins (docs/libration-analysis.md, confidence)
# L1 full: turning points at cutoffs x0.5, x1, x2 (three cycles) (convention)
MMR_L1_TP_FULL=7
# L2 without a zone: full below this amplitude [deg] (convention)
MMR_L2_AMP_FULL_DEG=120.0
# L2 without a zone: thin up to this amplitude, above it a medium cap [deg] (convention)
MMR_L2_AMP_THIN_DEG=160.0
# L5: T0 max/min within this x Omega_max/Omega_min (T0 resolution ~10%) (convention)
MMR_L5_RATIO_FULL=1.15
# L5 fails beyond this x the full threshold
MMR_L5_RATIO_FAIL=2.0
# above this e the period-amplitude law may fail: L5 at most thin
MMR_L5_E_CAVEAT=0.2
# L6 full: center shift <= this x the mean amplitude
MMR_L6_SHIFT_FULL=0.5
# L7 full: coverage gaps <= this x the period
MMR_L7_GAP_FULL=0.7
# L8 full: rotation per step below this (36 points per turn); not graded for a non_resonant circulation whose slow a stays MMR_FAR_FROM_RES_FACTOR a-scales from a* (the step need not resolve turning points it cannot have) [deg]
MMR_L8_STEP_FULL_DEG=10.0
# L8 full: filter gain at the cycle period >= this; below it, read with CONFIDENCE_THIN_BAND of its ratio (0.911), the libration is filter_too_slow (shape checks not_measured)
MMR_L8_GAIN_FULL=0.94
# L8 fails: filter gain at the cycle period below this
MMR_L8_GAIN_FAIL=0.5
# C1 full: largest center pass of a circulation in revolutions [rev]
MMR_C1_REV_FULL=10.0
# C3: rate modulation below this fraction of the mean rate
MMR_C3_MODULATION_MAX=0.3
# C5: |measured/expected rate - 1| <= this
MMR_C5_RATE_TOL=0.2
# C5 alias full: far from a* (MMR_FAR_FROM_RES_FACTOR) and the branch clearance per step [deg] > this x the largest per-step unwrap residual (smp_unwrap_resid_max_deg): no step can have been put on the wrong branch (convention)
MMR_C5_BRANCH_RESID_FACTOR=2.0
# C5 alias: far ratio below this is not an alias circulation but invalid/alias + resample
MMR_C5_FAR_RATIO_MIN=3.0
# O1: std of the a-wave before / in the episode thin from this
MMR_O1_RATIO_THIN=0.25
# O1: fails (cap low) from this
MMR_O1_RATIO_FAIL=0.5
# O1 not_applicable for an induced libration (origin_detail owner_libration) when the owner's libration intervals cover at least this fraction of O1's background window (the band before sigma's decisive episode): the a-wave there is the owner's libration, not a regime before a capture (convention)
MMR_O1_OWNER_COVER_MIN=0.5
# O1c (B4, W28): the a-wave before the episode is coherent at the episode's period P when one sinusoid at P explains at least this R^2 of its band-passed a (a wave, not encounter kicks or a circulation sweeping through the band); O1 fails only for a coherent, in-phase wave the episode's own law does not explain (convention)
MMR_O1_COHERENCE_R2_MIN=0.5
# O1c: that sinusoid continues into the episode in phase when its phase lies within this of the one fitted on the episode's first 2P [deg] (a wave the libration rides keeps its phase; a capture starts its own) (convention)
MMR_O1_PHASE_GAP_MAX_DEG=90.0
# O1l: the background's a_dot is explained by the episode's own force law (its K and phi0, the 1:1 law's K/K_theory; only a constant free) when its R^2 there is at least this fraction of the same R^2 on the episode: the circulation before a capture near the separatrix follows the same force (convention)
MMR_O1_OWN_LAW_R2_FRACTION=0.5
# q-2 b (author 2026-10-31): a verdict that claims the angle's own libration is high only when at least one physical support (L4 force law or the 1:1 law, R0, F by direct averaging) passes with its full margin, else the cap no_full_physics_support (<= medium) (convention)
MMR_HIGH_NEEDS_FULL_SUPPORT=True
# K1 full: correlation of slow sigma_dot with p varpi_dot
MMR_K1_FULL=0.97
# W full (no owner): best candidate R^2 below this
MMR_W_R2_NONE=0.4
# W full (induced): owner R^2 at least this
MMR_W_R2_FULL=0.85
# S full (none accepted): the closest member's center range > this x that of sigma0 in the same scan window
MMR_S_CLOSE_RATIO=0.8

# --- Secular and Lidov-Kozai angles (filter cutoff, turning points, the e/i response column)
# P_c of a secular angle >= this x the great inequality period (937 yr), the longest short-period term of an asteroid's elements: the filter passes 1/(1 + x^(2N)) of it (6% for x = 2, N = 2)
SECULAR_FILTER_GI_FACTOR=2.0
# P_c >= this x the longest forced wave 2 pi/|f - f_j| of the angle's own planetary modes (body f = g or s); a single-mode angle has none (its forced response is the resonance itself)
SECULAR_FILTER_FORCED_FACTOR=2.0
# turning-point prominence floor of a secular angle (see SECULAR_TP_RIPPLE_FACTOR) [deg] (convention)
SECULAR_TP_PROMINENCE_DEG=5.0
# shortest libration period of a secular angle, a convention: a pendulum librates no faster than half its rate width, and the widest linear resonances are a few arcsec/yr wide (nu6: +-1.2"/yr, Carruba et al. 2018), so periods are >~ 1 Myr; the fastest of the benchmark is Tina around its forced equilibrium (590 kyr). Faster 'episodes' are forced waves, and the TP prominence covers what sigma_f holds faster than this [yr] (convention)
SECULAR_LIBRATION_PERIOD_MIN_YR=200000.0
# TP prominence >= this x the 95th percentile of what sigma_f holds faster than SECULAR_LIBRATION_PERIOD_MIN_YR (a wave of half-amplitude r turns by up to 2 r)
SECULAR_TP_RIPPLE_FACTOR=4.0
# each run of turning points found at SECULAR_TP_PROMINENCE_DEG takes the TP prominence measured on its own samples (the MMR rule): a circulation elsewhere in the record must not set the threshold of a quiet libration (19289 s-s6: 77 deg from the record, 32 deg on the libration), never above the record's and never where it would lose a librating episode the record's finds (455327 g-s-g5+s6: the drifting approach to a libration); off: one prominence for the whole record
SECULAR_TP_LOCAL_PROMINENCE=True
# a run of turning points rejected only for its moving centre is a libration with a modulated centre when it closes a cycle, its turning points span less than a turn, its cycle centre turns back at least once (within LIBRATION_MODULATED_RANGE_MAX_RAD) and one of its cycles swings over every centre it has: a few slow cycles cannot show LIBRATION_CENTRE_RETURNS_MODULATED returns (42946 g-g6+s-s6, 1.3-14.6 Myr); a centre that moves one way stays a drift, a small wave carried by a slower motion stays rejected; off: the MMR count
SECULAR_TURNING_CENTRE=True
# an accepted episode of a secular angle that is a wave on a slower motion of the angle is no episode of it: a ripple on a slow swing (the slow motion between the centre turns around it stays within a turn and is at least 1/SECULAR_SLOW_SWING_RIPPLE_RATIO times as wide as the episode: 101703 g-2g6+g7, 1-Myr waves on a 12-Myr libration) or a stall of a circulation (the slow motion around runs a turn or more and keeps at least SECULAR_STALL_RATE_RATIO of its rate inside the episode: 348018 g-g5+s-s7); the slow scale then decides; off: every accepted episode counts
SECULAR_SLOW_WAVES=True
# an episode is a ripple on the slow swing around it when its largest half-amplitude is at most this x half the swing (the range of sigma_f between the centre turns that bracket it, or the record edges, below a turn); the MMR W34 ratio (convention)
SECULAR_SLOW_SWING_RIPPLE_RATIO=0.5
# a ripple on a slow swing must be carried by it: the slow track (sigma low-passed at LIBRATION_CENTRE_CYCLES x the episode's period) moves inside the episode at least this x its fastest rate beside it (over as long again on either side); a wave at a smooth turn of the slow motion reads >= 1/8 (the ratio of a parabola centred on the episode; 101703 g-2g6+g7: 0.12-0.16, 56700 s+s7-2s6: 0.51), a libration on a plateau of the slow motion stops it (two stationary librations joined by a monotone transition: <= 0.04) and stays an episode; half the parabola's 1/8 (convention)
SECULAR_SLOW_SWING_CARRY_RATIO=0.0625
# an episode inside a circulation (sigma_f runs a turn or more between the centre turns around it) is a stall, not a capture, when the slow track (sigma low-passed at LIBRATION_CENTRE_CYCLES x its period) carries the angle out of its band beside it (at least its largest half-amplitude over as long again on either side) and moves inside it at least this x that rate: a capture stops the circulation (19289, 278067 s-s6: <= 0.06), a stall only slows it (348018 g-g5+s-s7: 0.73) (convention)
SECULAR_STALL_RATE_RATIO=0.5
# the slow track's rate beside an episode (SECULAR_STALL_RATE_RATIO, SECULAR_SLOW_SWING_CARRY_RATIO) is read on an arm of as long again before its first and after its last turning point, inside the record; an arm the record cuts shorter than this fraction of the episode's span is not read (too short to show the motion the episode interrupts) (convention)
SECULAR_STALL_ARM_MIN_FRACTION=0.25
# when the angle at the centre scale W_c = LIBRATION_CENTRE_CYCLES x P_cyc shows no more libration than the fine scale, try the scale of the centre's own turns (the fine turning points at the centre prominence, W = their median period / FILTER_MIN_LIBRATION_CUTOFFS; the MMR G2c second scale): P_cyc of 1-Myr waves trims 3 Myr off each edge of a 12-Myr libration (101703 g-2g6+g7); off: W_c only
SECULAR_CENTRE_TURNS_SCALE=True
# check_secular_e_response passes when e_dot (and d sin(i/2)/dt for an s-angle) follows A sin(sigma) + B cos(sigma) + C with R^2 >= this; a column only, it changes no status and no confidence (convention)
SECULAR_RESPONSE_R2_MIN=0.5
# a secular libration or episode under the linear mode phases is resolved only when its swing 2 x the largest half-amplitude > this x dphi(T) = sum_j |k_j| range_j(T), how far the phases of the modes in the angle stray from the linear law over the record (table resonances/data/mode_phase_uncertainty.json); otherwise insufficient_time/phase_unresolved. Measured modes add nothing; 0 switches the check off (convention)
SECULAR_PHASE_UNCERTAINTY_FACTOR=1.0
# Lidov-Kozai thresholds by what they change (docs/config.md; most are set on a few objects, 591986 and 162474, and
# are recalibrated only on a larger ZLK sample):
#   column only (no status, no confidence): ZLK_MIN_ANTICORRELATION, ZLK_COHERENCE_CHECK, ZLK_EI_AMPLITUDE_FACTOR,
#     ZLK_EI_MIN_BAND_R, ZLK_EI_BAND_HALFWIDTH, ZLK_CENTRE_MIN_CYCLES, ZLK_NODE_LOCK_MIN_CYCLES
#   may change a status: ZLK_EI_MIN_CYCLES, ZLK_EI_PHASE_TOL_DEG,
#     ZLK_EI_EPISODE_MIN_COHERENCE, ZLK_EI_H_RESIDUAL_MAX (an episodic row without a gate verdict), ZLK_FILTER_GI_FACTOR, ZLK_LIBRATION_PERIOD_MIN_YR, ZLK_TP_*, ZLK_TURNING_CENTRE, ZLK_RUN_BREAK_HALF_AMPLITUDE_DEG
#     (physical), ZLK_RHO_WINDOW_CYCLES, ZLK_EPISODE_FREE_TURNS_PER_CYCLE, ZLK_GATE_EPISODES, ZLK_COORBITAL_HILL_FACTOR,
#     ZLK_CENTRE_MODEL_R_MIN, ZLK_CENTRE_MODEL_AMP_FACTOR, ZLK_ANGLE_FRAME, FREE_GATE_MIN_CYCLES, FREE_GATE_MASK_QUANTILE
#   budget (the action and extend_to_years only): ZLK_EXTEND_*, MMR_EXTEND_MIN_SPAN_FACTOR, MMR_NEXT_CHECK_SPAN_FACTOR
# P_c of the Lidov-Kozai angle omega >= this x the great inequality period (937 yr) (6% passes for x = 2, N = 2)
ZLK_FILTER_GI_FACTOR=2.0
# shortest libration period of omega, a convention: the quadrupole ZLK time (2/3pi)(M_sun/m_J) P_J^2/P (1 - e_J^2)^(3/2) (Antognini 2015, the coefficient of eq. 27) is 3.9 kyr at 4 au and 31 kyr at 1 au, and a libration lasts several of it; faster 'episodes' are forced waves [yr] (convention)
ZLK_LIBRATION_PERIOD_MIN_YR=2000.0
# TP prominence of omega >= this x the 95th percentile of what omega_f holds faster than ZLK_LIBRATION_PERIOD_MIN_YR
ZLK_TP_RIPPLE_FACTOR=4.0
# turning-point prominence floor of omega (see ZLK_TP_RIPPLE_FACTOR) [deg] (convention)
ZLK_TP_PROMINENCE_DEG=5.0
# each run of turning points of omega found at ZLK_TP_PROMINENCE_DEG takes the TP prominence measured on its own samples (as SECULAR_TP_LOCAL_PROMINENCE); off: one prominence for the whole record
ZLK_TP_LOCAL_PROMINENCE=True
# the rule of SECULAR_TURNING_CENTRE for omega; off: the MMR count of LIBRATION_CENTRE_RETURNS_MODULATED
ZLK_TURNING_CENTRE=True
# a run of omega breaks where a half-cycle swings this or more, or its center jumps by more (MMR and secular angles: 180): the averaged Lidov-Kozai Hamiltonian depends on 2 omega, so an island (omega about 90 or 270 deg) is at most half a turn wide; physical, not a convention [deg]
ZLK_RUN_BREAK_HALF_AMPLITUDE_DEG=90.0
# gate planetary_residual (a free rate d arcsec/yr from a planetary one, within the Rayleigh width 1296000/T): the extension asks for a free-element baseline of this x 1296000/d, where d is one width; a convention for the error of d itself (about one width of the record that measured it) (convention)
ZLK_EXTEND_RESOLUTION_MARGIN=1.25
# gate planetary_residual: a residual that needs a longer baseline than this to be told from the planetary rate (d < 1296000/this, 0.013 arcsec/yr) is not resolved by any practical run: action review instead of extend [yr] (convention)
ZLK_EXTEND_MAX_YR=100000000.0
# rho_max of the free-omega gate = max over the record of rollmed(|z_free|, W) / rollmed(|z_forced|, W), W = max(a tenth of the shortest beat of the fitted modes, this x P_cyc): the free and forced radii compared over one libration cycle, so a free circle that grows in a part of the record is seen (convention)
ZLK_RHO_WINDOW_CYCLES=1.0
# minimal policy (W30, D1/D2): rho_max at or above this excludes the kinematic mechanism (the forced vector cannot hold the perihelion: a non-resonant forced e is <= ~0.1, the free one three times larger); there a failed e-i integral is a veto and a held one with no gate verdict is full evidence (no cap, no extension) (convention)
ZLK_RHO_KINEMATIC_EXCLUDED=3.0
# an episodic omega is kinematic when inside every librating episode the median local rho < 1 and the free omega advances at least this many turns per cycle of the episode: a kinematic cycle is one turn of the free vector about the forced one, a dynamic one leaves the free omega librating (0); the midpoint (624 Hektor 0.94-1.0) (convention)
ZLK_EPISODE_FREE_TURNS_PER_CYCLE=0.5
# an episodic omega whose free omega winds over the record (gate kinematic or planetary_residual) is judged inside its librating episodes: confirmed when in every one the median local rho >= 1 and the free omega advances fewer than ZLK_EPISODE_FREE_TURNS_PER_CYCLE turns per cycle, with b_varpi and b_Omega off the g and s modes (between the episodes the osculating omega circulates, so the record always winds)
ZLK_GATE_EPISODES=True
# co-orbital guard of the free-omega gate: a body with |<a>/a_P - 1| < this x (m_P / 3 M_sun)^(1/3) (the Hill radius in units of a_P; the co-orbital region spans a few) of a planet whose own modes g_P, s_P are not among the fitted ones (Mercury to Mars) gets the outcome unavailable (coorbital_unfitted_forcing): its forced term is the planet's own vector, which the split does not hold (convention)
ZLK_COORBITAL_HILL_FACTOR=3.0
# zlk_ei_coupling: the phase of i against e at the decisive period lies within this of the sign of a law (180 deg for ZLK at constant sqrt(1-e^2) cos i, 0 deg for a forced-eccentricity beat at constant sqrt(1-e^2)(1-cos i)); 45 deg is halfway to quadrature; also the episode coupling (zlk_ei_episode_coupling), which an episodic row without a gate verdict reads [deg] (convention)
ZLK_EI_PHASE_TOL_DEG=45.0
# zlk_ei_coupling: the measured |delta i| / |delta e| lies within [1/x, x] of the law it is named after (librators measure 1.0-1.6 x the constant-H law); a column only (convention)
ZLK_EI_AMPLITUDE_FACTOR=2.0
# zlk_ei_coupling: e and i band-passed around the decisive period correlate with the sign of the law at least this (|r| >= x); weaker is no coupling (as ZLK_MIN_ANTICORRELATION); a column only (convention)
ZLK_EI_MIN_BAND_R=0.5
# zlk_ei_coupling: the band of r is [(1 - x)/P, (1 + x)/P] around the decisive period P (Butterworth order 3, forward-backward); narrower bands correlate any two lines (convention)
ZLK_EI_BAND_HALFWIDTH=0.2
# zlk_ei_coupling is measured on the record less one period at each edge, when that holds at least this many periods (else not_measured): the two sinusoid fits need the line resolved; the episode coupling (zlk_ei_episode_*) when the deciding episode spans this many periods between its first and last turning points (two blind estimators agree 3 of 11 times on 1.5-3-period episodes, 39 of 40 on longer ones) (convention)
ZLK_EI_MIN_CYCLES=3.0
# zlk_ei_episode_coupling: e and i demodulated at the deciding episode's period P (one-period boxcar) keep their relative phase through the episode, |sum E* I| / sqrt(sum |E|^2 sum |I|^2) >= this with the sign of the law (as ZLK_EI_MIN_BAND_R) (convention)
ZLK_EI_EPISODE_MIN_COHERENCE=0.5
# zlk_ei_episode_coupling zlk needs the quadrupole integral H = sqrt(1-e^2) cos i conserved at P inside the deciding episode: eta_H = |delta H| / |cos i delta sqrt(1-e^2)| <= this (0 = H exactly conserved, 1 = i frozen; forced_beat reads eta_K of K = sqrt(1-e^2)(1 - cos i) the same way); the benchmark's zlk items measure <= 0.28, the others >= 0.58; the slope |di|/|de| over the law fails on large cycles and stays a column (convention)
ZLK_EI_H_RESIDUAL_MAX=0.5
# zlk_centre_origin: the slow line of the center of omega is named after a model (the phase wave of the fitted forced eccentricity vector, forced_beat; the node, node) when the model, smoothed like the center, correlates with it at least this (591986: 0.99 for g6-g5); the center-scale guard (sec_centre_rejected) reads the same test (convention)
ZLK_CENTRE_MODEL_R_MIN=0.9
# a model explains the slow wave of the center of omega (zlk_centre_origin; the center-scale guard, sec_centre_rejected) only when its swing, smoothed like the center, is within [1/x, x] of the center's (zlk_centre_model_gain; 591986 g6-g5: about 1): correlation alone is blind to size, a forced term of zero amplitude must not explain a real wave (convention)
ZLK_CENTRE_MODEL_AMP_FACTOR=2.0
# the slow line of the center (zlk_centre_*, secular modulated: sec_centre_*) is searched between the center smoothing W_c and the center track span / this: a period is measured only when the track holds this many of it; a column only (convention)
ZLK_CENTRE_MIN_CYCLES=2.0
# zlk_node_lock (a flag, no status reads it): the node is locked to a fitted forced eccentricity mode g_j when its rate matches g_j within one Rayleigh width, Omega - varpi_j stays within a turn and, smoothed past the forced waves of the node, completes at least this many full cycles between its first and last turning points: one closed cycle tells a libration from a slow circulation (591986: 1.5 cycles of 1.46 Myr over 4 Myr, none over 500 kyr) (convention)
ZLK_NODE_LOCK_MIN_CYCLES=1.0
# the plane omega, i and Omega of a Lidov-Kozai row are measured from: 'invariable' (the plane of the planets' total angular momentum, by an exact rotation of the orbit's vectors; the angle, its diagnostics, the free elements and the figure) or 'ecliptic' (J2000; a node tilted by about the plane's own 1.58 deg librates about the plane's node from the ecliptic instead of turning, and omega with it: 555527)
ZLK_ANGLE_FRAME=invariable

# --- Confidence (shared)
# margin U: a decision within this relative distance of a convention; also a secular or ZLK record too short for one cycle that ends in circulation by an end travel below 1 + this many turns is at most medium (W36)
CONFIDENCE_THIN_BAND=0.1
# minimal policy: complete libration cycles N a resonant or transient row needs for medium; fewer (one closed cycle, a single 1:1 leg) is low, the angle bounded too briefly to call its libration established (convention)
CONFIDENCE_MEDIUM_CYCLES=1.5
# minimal policy: complete libration cycles N a resonant or transient row needs for high (with the vetoes measured, clean or partial); fewer is medium. Also the A4 extend clause: a last counted episode that reaches the record end with fewer cycles extends (convention)
CONFIDENCE_HIGH_CYCLES=2.0
# minimal policy: complete libration cycles N for certain, with the amplitude margin full, the filter stable and every veto measured clean (the same for every resonance type: two returns carry the same information at any period; W31, Codex review and the author) (convention)
CONFIDENCE_CERTAIN_CYCLES=3.0
# minimal policy: certain also needs this many observed cycles (n_TP - 1) / 2 inside the decisive episode itself, so that inferred edge coverage or a sum of short episodes alone never gives the top level (convention)
CONFIDENCE_CERTAIN_CORE_CYCLES=3.0
# minimal policy: the highest level of a resonant or transient MMR row whose own force is not shown: none of the force law on a (L4, the 1:1 law included), the energy/period law (R0) and the strength (F) passes. The a<->sigma identity holds for any orbit, so the geometry alone shows a bounded angle, not a resonant force (W33, the author and Codex); 'certain' = no limit (convention)
CONFIDENCE_GEOMETRY_ONLY_MAX=low
# calibration cells with their author-label counts, written by benchmark/tools/calibrate.py and reported in the cell_* columns, never changing a level (empty = resonances/data/confidence_cells.json)
CONFIDENCE_CELLS=

# --- Dry-run before integrating (does not change any verdict; docs/dry-run.md). The step rules reuse the analysis'
# own settings: MMR_STEP_RESOLVED_DEG (rotation per step), the cutoff rule and MMR_RESAMPLE_STEPS_PER_CYCLE against
# MMR_LIBRATION_PERIOD_MIN_YR / MMR_COORBITAL_PERIOD_FLOOR_FACTOR (shortest libration), MMR_JITTER_MAX_RAD; the pilot's
# leak test uses MMR_TP_PROMINENCE_FLOOR_DEG, MMR_TP_RIPPLE_FACTOR and CONFIDENCE_THIN_BAND.
# 'required' = the step resolves FAIR; 'optional'
DRYRUN_FAIR=optional
# FAIR needs a step <= this x the orbital period (1/4.2)
DRYRUN_FAIR_FRACTION=0.238
# spread of a without a pilot: belt, NEA, planet-crossing (provisional) [au]
DRYRUN_DA_STATIC=0.005,0.001,0.002
# short-period a scatter without a pilot: belt, NEA, crossing [au]
DRYRUN_DA_SP_STATIC=0.003,0.0003,0.001
# SABA steps per orbit (measured)
DRYRUN_STEPS_PER_ORBIT=10.0
# SABA steps per perihelion passage (provisional)
DRYRUN_STEPS_PER_PERI=10.0
# ias15 below this perihelion distance [au]
DRYRUN_NEA_Q=1.3
# crossing band around a planet orbit in Hill radii
DRYRUN_HILL_MARGIN=1.0
# drop guaranteed aliased circulations before integrating
DRYRUN_DROP_ALIASED=False
# drop only beyond this many Nyquist half-widths from a_res
DRYRUN_DROP_GHOST_FACTOR=20.0
# output step of the pilot integration [yr]
DRYRUN_PILOT_STEP_YR=0.05
# shortest pilot [yr]
DRYRUN_PILOT_MIN_YR=600.0
# longest pilot [yr]
DRYRUN_PILOT_MAX_YR=3000.0
# pilot length >= this x the predicted cutoff
DRYRUN_PILOT_CUTOFFS=10.0
# round values OUTPUT_STEP='auto' is chosen from [yr]
DRYRUN_AUTO_STEPS_YR=0.05,0.1,0.2,0.25,0.5,1.0,2.0,2.5,5.0,10.0,20.0,50.0,100.0,200.0,500.0
# the user's cap on OUTPUT_STEP='auto' (empty = none) [yr]
DRYRUN_MAX_STEP_YR=
# pilot: report a line of sigma the filter passes (period >= P_c) whose filtered amplitude reaches this [deg]
DRYRUN_FORCED_TERM_MIN_DEG=2.0
# pilot: name such a line |p n_j - q n| with p, q up to this
DRYRUN_FORCED_TERM_MAX_COEFFICIENT=12

# --- Output of the MMR analysis
# episodes.csv for every MMR row with a run of turning points
SAVE_EPISODES=True
# candidates.csv: 'top' = the best MMR_SUBRESONANCE_TOP_N / MMR_OWNER_TOP_N and the accepted ones, 'all'
SAVE_CANDIDATES=top
# constants.csv (planets' mean motions, frequencies, great inequality), one per run
SAVE_CONSTANTS=True
# Output step in years (Nout = span / step + 1), or 'auto' (the static dry-run chooses it before the run; runs with MMRs
# only, docs/dry-run.md). Empty = the default Nout = |tmax| / 100 (15.9 yr). An explicit Nout overrides it.
OUTPUT_STEP=

# File paths
SOLAR_SYSTEM_FILE=cache/solar.bin
# Which rows keep their series (data files), by the verdict (simulation/config.py SavePlotMode): none, all, resonant,
# candidates, extended, nonzero (every row except non_resonant without a libration origin), review (nonzero plus the
# review queue, summary.csv review_required: non_resonant at medium or low confidence; W28 g10-1b, the author
# 2026-10-31), negative. An output selection, not an analysis setting (outside settings_hash). review keeps more series
# than nonzero (benchmark: 540 rows instead of 490), so the data folder grows with them; the log says by how much.
SAVE=review
SAVE_SUMMARY=True
# Planets kept in memory and written to data-planet-<planet>.csv: 'all', 'analysis' (the planets of the bodies'
# resonances + MMR_OWNER_PLANETS when the run has an MMR and the owner search is on) or 'none'. True = all, False = none.
# secular_planet_phases='measured' needs 'all'; without the planets the MMR owner search is not measured.
SAVE_PLANETS=analysis
# A run writes into SAVE_PATH/<name> (and its figures into PLOT_PATH/<name>). summary.csv, episodes.csv and the other
# tables and simulation.json stay at the top of it; the folders below are relative to it (empty = the top itself)
SAVE_PATH=cache
PLOT_PATH=cache
# the series CSVs: data-<body>.csv, data-<body>-periodograms.csv, <body>-omega-free.csv, data-planet-<planet>.csv
DATA_FOLDER=data
# the individual figures (evolution, portrait, ecc_vector, ...) and the combined (verdict) figures, under PLOT_PATH/<name>
PLOT_FIGURES_FOLDER=figures
PLOT_COMBINED_FOLDER=combined
# Subfolders inside both: 'flat' = none, or levels joined by '/', outermost first, from status, confidence
# (certain, high, medium, low; 'none' for uncertain/invalid), type (mmr, secular, lidov_kozai), resonance, body.
# Presets: flat, status, confidence, confidence/status, status/confidence, type/status, type/confidence/status,
# resonance, body. Empty = confidence/status (e.g. combined/high/resonant/).
PLOT_LAYOUT=
# the layout of the combined figures alone (empty = PLOT_LAYOUT)
PLOT_COMBINED_LAYOUT=
# Which rows are drawn: the modes of SAVE (review = nonzero plus the review queue, the default). The arrays of a row
# that will not be drawn are released right after its verdict, by the same selection.
PLOT=review
PLOT_TYPE=save
PLOT_IMAGE_TYPE=png
PLOT_CONFIG=full
# Plot kinds to generate (comma-separated): evolution, ecc_vector, cross_spectrum,
# free_omega (Lidov-Kozai only), recurrence, fair, cycles (MMR only), angle, rate (secular and Lidov-Kozai),
# combined (the one-page verdict figure, MMR, secular, ZLK), portrait (MMR, secular and Lidov-Kozai)
PLOTS=combined
# Resonance types drawn whatever their status (comma-separated: mmr, secular, lidov_kozai);
# empty = the PLOT mode decides for every resonance
PLOT_ALWAYS=
# Options of the MMR diagnostic plots as JSON, merged over the defaults, e.g.
# {"style": "paper", "raw": "none", "portrait": {"y": "axis"}, "combined": {"osculating_a": "hidden"}}.
# Empty = defaults (docs/plots.md)
PLOT_OPTIONS=

# Data and catalog settings
# Where the asteroids' elements come from: nasa (Horizons at DATE), astdys (allnum.cat) or mpc (MPCORB). The planets
# always come from Horizons, at the date. Without a date: today for nasa, the catalog's epoch for astdys and mpc.
DATA_SOURCE=nasa
# MPC catalog: mpcorb (MPCORB.DAT.gz, every numbered and multi-opposition orbit), nea, neam00 (NEAs at today's
# epoch), distant, unusual, or a URL of a file in the MPCORB format. Cached in MPC_CACHE_DIR/<catalog>/ with its
# sha256, ETag and Last-Modified; refreshed only by `resonances mpc-update` (docs/config.md). The catalog code is
# resonances/mpcorb (also `resonances mpc-search` and resonances.mpcorb.query); these keys are its settings
MPC_CATALOG=mpcorb
MPC_CACHE_DIR=cache/mpc
# Warn when the cached catalog is older than this (days since its Last-Modified; 0 = never)
MPC_MAX_AGE_DAYS=30
# Refuse a cached catalog with another sha256 (empty = any): pins a run to one snapshot
MPC_SHA256=
# A row whose epoch is not the date: propagate (default) = integrated to the date in the package's model (IAS15, the
# run's planets) with a warning per body, then all bodies run together; strict = refused (find leaves it out)
MPC_EPOCH_POLICY=propagate
# Optional safety limit on the propagated span, days (empty = no limit). 138 d agreed with MPC's own propagation to
# da <= 5e-8 AU; longer spans are not validated. The clones (CLONES) carried over a longer span get a warning only
MPC_PROPAGATE_MAX_DAYS=
# Warn about orbits with MPC's uncertainty parameter U at least this (0 best .. 9 worst), or without one
MPC_WARN_U=6
# An identifier the cached catalog does not have (an alias such as a secondary designation, an object outside the
# MPC_CATALOG subset, one newer than the snapshot): file = not found (find leaves it out); file_then_api = its nominal
# orbit from MPC's get-orb API (no covariance needed), cached in CLONES_CACHE_DIR/mpc/ with its sha256, then the epoch
# policy above. Never widens a search: only explicitly named identifiers are asked for, in the parent process
MPC_LOOKUP=file

# Matrix settings. The catalogs are cached at *_FILE (relative to the working directory) with a build record
# <file>.meta.json; a cache built with other limits/planets, or without a record, is read as is with a warning:
# delete it to rebuild (the retrograde catalog is rebuilt on its own when its limits change)
# the first planet's coefficient runs from 1 to MATRIX_3BODY_PRIMARY_MAX - 1 (an exclusive bound); the second planet's
# and the asteroid's from -MATRIX_3BODY_COEF_MAX to MATRIX_3BODY_COEF_MAX - 1
MATRIX_3BODY_PRIMARY_MAX=8
MATRIX_3BODY_COEF_MAX=7
# largest order of the three-body catalog; also the largest degree (sum of |slow coefficients|) of the subresonances scanned and listed (members of degree |q| always)
MATRIX_3BODY_ORDER_MAX=6
MATRIX_3BODY_FILE=cache/mmr-3body.csv
# the planet's coefficient runs from 1 to MATRIX_2BODY_PRIMARY_MAX - 1 (an exclusive bound); the asteroid's from
# -MATRIX_2BODY_COEF_MAX to -1
MATRIX_2BODY_PRIMARY_MAX=12
MATRIX_2BODY_COEF_MAX=11
# largest order of the two-body catalog; also the largest degree (sum of |slow coefficients|) of the subresonances scanned and listed (members of degree |q| always)
MATRIX_2BODY_ORDER_MAX=10
MATRIX_2BODY_FILE=cache/mmr-2body.csv
# Retrograde p/-q resonances (1J-3r0): p, q up to COEF_MAX, p+q up to ORDER_MAX, every k (Li et al. 2019)
MATRIX_2BODY_RETRO_COEF_MAX=15
MATRIX_2BODY_RETRO_ORDER_MAX=30
MATRIX_2BODY_RETRO_FILE=cache/mmr-2body-retro.csv

# Batch processing settings
BATCH_ENABLED=True
BATCH_THRESHOLD=100
BATCH_SIZE=100
BATCH_N_CORES=3
# Allocator of spawned worker processes (auto | on | off). On macOS "on" starts them with MallocLargeCache=0: freed large
# blocks go back to the system instead of staying in the worker's footprint (benchmark workers: max 2.34 -> 1.42 GB,
# the same results, more CPU). auto: on where memory, not the CPUs, limits the worker count (benchmark --workers auto);
# a batch run's n_cores is the user's, so auto is off there. No policy on other systems (not measured).
LOW_MEMORY_ALLOCATOR=auto

# Clones (virtual asteroids, docs/clones.md): CLONES per body added by its number or designation (0 = off). Status
# shares of N clones are known to +-10 % (N = 100), +-5 % (400), +-3 % (1000) at 95 % (Wilson). They are drawn from the
# orbit fit's covariance (multivariate normal in the fit's own coordinates) and run after the ordinary bodies.
CLONES=0
# auto (the provider of DATA_SOURCE: astdys -> astdys, mpc -> mpc, nasa -> sbdb), astdys (numbered), neodys (NEAs), sbdb
# (JPL) or mpc (refused for U >= 3: MPC has the covariance only at its standard epoch)
CLONES_SOURCE=auto
# AstDyS/NEODyS covariance epoch: fit (.eq0, the fit's own epoch, near the middle of the arc) or standard (.eq1, the
# catalog's epoch, a linear propagation of .eq0). Empty = standard for astdys, fit for neodys. A covariance at another
# epoch than DATE is sampled there and each clone integrated to DATE (IAS15, the run's planets).
CLONES_EPOCH=
# Seed of the draws: one generator per body, seeded by (seed, crc32(name)); the first N of a larger N are the same
CLONES_SEED=0
# Clones per REBOUND simulation (the batch of a worker; the workers are BATCH_N_CORES)
CLONES_BATCH=20
# Largest share of draws that are no bound orbit (e < 0, e >= 1, a <= 0) for which the clone shares are given. The
# shares are over the bound draws only (an unbound draw is not integrated, so it is no observation); above this share
# the Gaussian is no usable model of the orbit's uncertainty (1-day arcs: 2010 CG236 100 %, 2010 DH65 83 %) and the
# clones.csv row has cloud_usable False and no shares. A convention.
CLONES_MAX_INVALID=0.05
# Figures of every clone as of an ordinary body (False: only the ensemble figure, PLOTS clones or combined)
CLONES_PLOT_EACH=False
# Downloaded orbit solutions (one per object and source, refreshed only with orbit_solution(..., refresh=True))
CLONES_CACHE_DIR=cache/clones

# Logging
LOG_FILE=cache/resonances.log
LOG_LEVEL=info

# Free (proper) elements: forced/free split of the eccentricity and inclination vectors.
# Sampling is the step the series are decimated to before the split; leave empty to keep
# the integration grid. See docs/free-elements.md.
FREE_ELEMENTS_ENABLED=True
FREE_ELEMENTS_SAMPLING_YEARS=500

# The free-omega gate, a step of the Lidov-Kozai analysis (analyse_zlk): its outcome is read by
# analysis.secular.decide.decide_status. A libration is confirmed (resonant), kinematic
# (non_resonant, reason kinematic_libration) or without a verdict (uncertain, gate_unavailable);
# an episodic angle, a drift or a short record changes only on a kinematic outcome. Disabled:
# the geometric status stays, check_zlk_free_omega not_measured. Min cycles is how many libration
# periods the baseline must hold before the gate will judge at all. Mask quantile drops samples where |z_free| falls
# below that fraction of its median, since the argument is undefined near the origin.
FREE_GATE_ENABLED=True
FREE_GATE_MIN_CYCLES=3
FREE_GATE_MASK_QUANTILE=0.15
