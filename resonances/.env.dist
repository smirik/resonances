# Classification settings
# Window step sizes (comma-separated fractions of total length)
CLASSIFY_WINDOW_STEPS=0.1,0.2,0.3
# Step size as fraction of total length for sliding window
CLASSIFY_WINDOW_STEP=0.05

# Global thresholds
# Max revolutions_true for the global libration branch
CLASSIFY_REV_LIBRATION=1.0
# Max TTO for "pure libration" subtype (high confidence)
CLASSIFY_TTO_PURE_LIBRATION=0.5
# Max TTO for "partial libration" subtype (medium confidence)
CLASSIFY_TTO_PARTIAL_LIBRATION=2.5
# TTO above which classified as non-resonant circulation
CLASSIFY_TTO_NON_RESONANT=6.0
# Max global TTO to qualify as transient (with good segments)
CLASSIFY_TTO_TRANSIENT_GLOBAL=3.0
# Max global TTO for near-separatrix (with reasonable segments)
CLASSIFY_TTO_NEAR_SEPARATRIX=6.0

# Segment quality thresholds — "good" segment
# Max revolutions_true for a segment to count as "good"
CLASSIFY_GOOD_SEG_MAX_REV=1.0
# Max TTO for a segment to count as "good"
CLASSIFY_GOOD_SEG_MAX_TTO=0.5

# Segment quality thresholds — "reasonable" segment (OR of two conditions)
# Condition 1: rev <= MAX_REV_1 AND tto < MAX_TTO_1
CLASSIFY_REASONABLE_SEG_MAX_REV_1=2.0
CLASSIFY_REASONABLE_SEG_MAX_TTO_1=1.0
# Condition 2: rev <= MAX_REV_2 AND tto < MAX_TTO_2
CLASSIFY_REASONABLE_SEG_MAX_REV_2=1.0
CLASSIFY_REASONABLE_SEG_MAX_TTO_2=1.5

# Libration settings
LIBRATION_FILTER_CUTOFF=0.0005
LIBRATION_FILTER_ORDER=2
LIBRATION_FREQ_MIN=0.00001
LIBRATION_FREQ_MAX=0.002
LIBRATION_CRITICAL=0.1
LIBRATION_SOFT=0.05
LIBRATION_PERIOD_MIN=500
LIBRATION_PERIOD_CRITICAL=20000
LIBRATION_MONOTONY_CRITICAL=0.4,0.6

# Filtering config
FILTER=butter

# Cross-spectral coherence (sigma vs a/e/i, e vs i) — see docs/coherence.md
COHERENCE_ENABLED=True
# Skip bodies classified as non-resonant (status = 0); they dominate mass surveys
COHERENCE_SKIP_NON_RESONANT=True
# Per-bin false-alarm probability: gamma2_crit = 1 - alpha^(1/(n_seg-1))
COHERENCE_ALPHA=0.01
# Welch segmentation levels (comma-separated). The coarsest valid one decides.
COHERENCE_N_SEGMENTS=4,8,16
COHERENCE_WINDOW=hann
# Max coherent lines kept per pair per level in coherence.csv
COHERENCE_MAX_LINES=10
# Extra narrowing of the search band, in years. Empty = use the per-resonance-type
# preset (10000 for Lidov-Kozai and secular) and the intrinsic 4*dt .. T/(5*n_seg) limits.
COHERENCE_PERIOD_MIN=
COHERENCE_PERIOD_MAX=
# Measure whether e and i really exchange at the strongest coherent line -> confirmed_ei.
# Diagnostic: since the free-omega gate took over, this no longer changes any status.
ZLK_COHERENCE_CHECK=True
# Minimum |r| of band-passed e vs i for the antiphase line to count as a real exchange.
# PROVISIONAL: calibrated on two objects (591986 reaches 0.38 and is not resonant,
# 162474 reaches 0.79 and is). Revisit once a larger sample exists.
ZLK_MIN_ANTICORRELATION=0.5

# Integration settings
INTEGRATION_TMAX=628319
INTEGRATION_DT=1.0
INTEGRATION_INTEGRATOR=SABA(10,6,4)
INTEGRATION_SAFE_MODE=0
INTEGRATION_CORRECTOR=17

# Secular resonances
SECULAR_ANGLE_MODE=proper

# File paths
SOLAR_SYSTEM_FILE=cache/solar.bin
SAVE=nonzero
SAVE_SUMMARY=True
SAVE_PLANETS=False
SAVE_ADDITIONAL_DATA=True
SAVE_PATH=cache
PLOT_PATH=cache
PLOT=nonzero
PLOT_TYPE=save
PLOT_IMAGE_TYPE=png
PLOT_SUBFOLDER_STRATEGY=
PLOT_CONFIG=full
# Plot kinds to generate (comma-separated): evolution, ecc_vector, cross_spectrum,
# free_omega (Lidov-Kozai only), combined, recurrence, fair, portrait, cycles (MMR only)
PLOTS=evolution
# Resonance types drawn whatever their status (comma-separated: mmr, secular, lidov_kozai);
# empty = the PLOT mode decides for every resonance
PLOT_ALWAYS=
# Options of the MMR diagnostic plots as JSON, merged over the defaults, e.g.
# {"style": "paper", "raw": "none", "portrait": {"y": "axis"}}. Empty = defaults (docs/plots.md)
PLOT_OPTIONS=

# Data and catalog settings
DATA_SOURCE=nasa
CATALOG_PATH=cache/allnum.csv
ASTDYS_URL=https://newton.spacedys.com/~astdys2/catalogs/allnum.cat
ASTDYS_CATALOG=cache/allnum.cat

# Matrix settings
MATRIX_3BODY_PRIMARY_MAX=8
MATRIX_3BODY_COEF_MAX=7
MATRIX_3BODY_ORDER_MAX=6
MATRIX_3BODY_FILE=cache/mmr-3body.csv
MATRIX_2BODY_PRIMARY_MAX=12
MATRIX_2BODY_COEF_MAX=11
MATRIX_2BODY_ORDER_MAX=10
MATRIX_2BODY_FILE=cache/mmr-2body.csv

# Batch processing settings
BATCH_ENABLED=True
BATCH_THRESHOLD=100
BATCH_SIZE=100
BATCH_N_CORES=3

# Logging
LOG_FILE=cache/resonances.log
LOG_LEVEL=info

# Free (proper) elements: forced/free split of the eccentricity and inclination vectors.
# Sampling is the step the series are decimated to before the split; leave empty to keep
# the integration grid. See docs/free-elements.md.
FREE_ELEMENTS_ENABLED=True
FREE_ELEMENTS_SAMPLING_YEARS=500

# The free-omega gate. This is what decides a Lidov-Kozai status after classification:
# a librating status 2 is confirmed, demoted to -2 (the libration was kinematic) or set
# to -9 (no verdict). Min cycles is how many libration periods the baseline must hold
# before the gate will judge at all. Mask quantile drops samples where |z_free| falls
# below that fraction of its median, since the argument is undefined near the origin.
FREE_GATE_ENABLED=True
FREE_GATE_MIN_CYCLES=3
FREE_GATE_MASK_QUANTILE=0.15

# Fundamental planetary frequencies for secular resonances (in arcsec/yr)
g5=4.25749319
g6=28.24552984
g7=3.08675577
g8=0.67255084
s5=0
s6=-26.34496354
s7=-2.99266093
s8=-0.69251386
